{
  "dataList": [
    {
      "id": 0,
      "model": "카르멘",
      "content": "世界は恐ろしい。"
    },
    {
      "id": 1,
      "model": "카르멘",
      "content": "いつからか、ただ存在しているだけで、\n私たちはその慣性へ吸い込まれていく。"
    },
    {
      "id": 2,
      "model": "카르멘",
      "content": "価値を追い、既存の意味に心を注ぐけれど、\nその意味は既にずっと昔から続いていただけ。"
    },
    {
      "id": 3,
      "model": "카르멘",
      "content": "人々の生の中で、たまたま作られた…。"
    },
    {
      "id": 4,
      "model": "카르멘",
      "content": "ただ転がるうち、中途半端に形が定まってしまった意味。"
    },
    {
      "id": 5,
      "model": "카르멘",
      "content": "そんな価値に押し潰され、巻き込まれた人類は\n感情を使い果たし、与えられた時間を浪費する。"
    },
    {
      "id": 6,
      "model": "카르멘",
      "content": "生まれたばかりの赤子は、世界を知らない。"
    },
    {
      "id": 7,
      "model": "카르멘",
      "content": "望みもせず与えられた\n人間としての本性だけを抱く、その生の脈動の上に…。"
    },
    {
      "id": 8,
      "model": "카르멘",
      "content": "世界は人類の価値観と呼ばれる\n衣服を、足枷を、容赦なく被せる。"
    },
    {
      "id": 9,
      "model": "카르멘",
      "content": "教育と学習。その二つの名目の下\n人間は型にはめられ、打ち出されていく。"
    },
    {
      "id": 10,
      "model": "카르멘",
      "content": "私が望むのは…自ら描いた、自分の姿で生きること。"
    },
    {
      "id": 11,
      "model": "카르멘",
      "content": "この冷たく無関心な世界に、温かさを塗ること。"
    },
    {
      "id": 12,
      "model": "카르멘",
      "content": "価値観の車輪に巻き込まれ、\n押し潰される人類のために、抜け出す方法をもたらすこと。"
    },
    {
      "id": 16,
      "model": "카르멘",
      "content": "それが私の願い。私が与えたい贈り物。"
    },
    {
      "id": 17,
      "model": "카르멘",
      "content": "私がしたい治療。"
    }
  ]
