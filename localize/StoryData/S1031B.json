{
  "dataList": [
    {
      "id": 0,
      "place": "1F ビューティーフロア",
      "model": "크로머언니",
      "content": "今度はあんたが、首を長くして私を待っていたの？"
    },
    {
      "id": 1,
      "model": "이상",
      "content": "…今、我々に語りかけたまうや？"
    },
    {
      "id": 2,
      "model": "단테",
      "content": "<…あの人はクローマーの姉だよ。名前は妹と同じクローマー。>"
    },
    {
      "id": 3,
      "model": "싱클레어",
      "content": "…！"
    },
    {
      "id": 4,
      "model": "싱클레어",
      "content": "あの感じ…はい、間違いありません。"
    },
    {
      "id": 5,
      "content": "にこにこと笑って私を見るその者を目にして…\nまた一つ、気づくことができた。"
    },
    {
      "id": 6,
      "content": "そうか、あの者は…。"
    },
    {
      "id": 7,
      "content": "この繰り返しを、私の虚しさを知っているんだ。"
    },
    {
      "id": 8,
      "content": "私は大股でその者の前へ歩み寄った。驚愕するウーティスの声と、\nシンクレアの驚いた息遣いが聞こえたが、気にしなかった。"
    },
    {
      "id": 9,
      "model": "크로머언니",
      "content": "わぁ…近づきすぎじゃない？私が妹みたいに分別をなくして、\nあんたを叩き壊すことに夢中になったらどうするつもり？"
    },
    {
      "id": 10,
      "model": "홍루",
      "content": "あれ？あの…あちらにいるのは、ムルソーさんじゃありませんか？\nクローマーのお姉さんの後ろに…。"
    },
    {
      "id": 11,
      "content": "ホンルの指差した先には…もうSPAフロアに縛りつけられず、\nここまで駆けつけたムルソーが見えた。"
    },
    {
      "id": 12,
      "model": "단테",
      "content": "<…ムルソー。>"
    },
    {
      "id": 13,
      "model": "뫼르소",
      "content": "管理人様。"
    },
    {
      "id": 14,
      "model": "단테",
      "content": "<今回はSPAフロアにいなかったんだね。>"
    },
    {
      "id": 15,
      "model": "뫼르소",
      "content": "はい。今回は保管されることを拒否しました。"
    },
    {
      "id": 16,
      "model": "단테",
      "content": "<…ムルソー、あの人に聞いて。>"
    },
    {
      "id": 17,
      "model": "단테",
      "content": "<止める方法を知ってるなら、教えてほしいって。>"
    },
    {
      "id": 18,
      "model": "싱클레어",
      "content": "どういうことですか？何の方法ですか？"
    },
    {
      "id": 19,
      "model": "단테",
      "content": "<あの人はここについての情報を知ってるんだ、シンクレア。\nそれに…私たちを助けるのを嫌がったりはしないはず。>"
    },
    {
      "id": 20,
      "content": "理由は分からないけれど、あの者は私たちがどんな形であれ\n進み続けることを望んでいるようだった。実際、地下2階では助けてくれもした。"
    },
    {
      "id": 21,
      "model": "뫼르소",
      "content": "…別の方法を知っているのなら…。"
    },
    {
      "id": 22,
      "model": "뫼르소",
      "content": "教えてくれるよう要請する。"
    },
    {
      "id": 23,
      "model": "크로머언니",
      "content": "…がっかりだね？\nわざわざ私が言ってあげないと分からないの？"
    },
    {
      "id": 24,
      "model": "크로머언니",
      "content": "何度も言うけど、私の妹がたかがこの程度の会社に押し負けたっていうなら…\nよくやってくれたね。あとで私の足を引っ張るだけだっただろうし。"
    },
    {
      "id": 25,
      "model": "싱클레어",
      "content": "……。"
    },
    {
      "id": 26,
      "model": "크로머언니",
      "content": "まだ分からない？"
    },
    {
      "id": 27,
      "model": "크로머언니",
      "content": "発想の転換！"
    },
    {
      "id": 28,
      "model": "크로머언니",
      "content": "が必要なときなんだよ。"
    },
    {
      "id": 29,
      "model": "크로머언니",
      "content": "百貨店が決めた道だけを大人しく進んでおいて…\n変わらないなんて言うのは、あまりに生意気じゃない？"
    },
    {
      "id": 30,
      "model": "단테",
      "content": "<百貨店が決めた道…。>"
    },
    {
      "id": 31,
      "model": "크로머언니",
      "content": "規則があるならまず破らないと。\n百貨店の変化を語れるのは、それからじゃない？"
    },
    {
      "id": 32,
      "model": "크로머언니",
      "content": "だから、気持ちいいくらいに壊して。\n私の妹にそうしたように。"
    },
    {
      "id": 33,
      "model": "크로머언니",
      "content": "ここで時を待って、隠れている人たちのようにね。"
    },
    {
      "id": 34,
      "model": "단테",
      "content": "<……。>"
    },
    {
      "id": 35,
      "model": "단테",
      "content": "<あなたが、ル・ネアンの巨人なんだね。>"
    },
    {
      "id": 36,
      "model": "단테",
      "content": "<百貨店を背負う四人の巨人の一人。>"
    },
    {
      "id": 37,
      "model": "크로머언니",
      "content": "ははっ！何て言ってるのか、分かるわけないでしょ。"
    },
    {
      "id": 38,
      "model": "크로머언니",
      "content": "義体なんかに快く手を貸してくれて、\n恐悦至極ってことにしておくね？"
    },
    {
      "id": 39,
      "model": "크로머언니",
      "content": "次に会うのは…あんたたちが百貨店の規則を見事に破ってから…。"
    },
    {
      "id": 40,
      "model": "크로머언니",
      "content": "そのとき、また会おう。"
    },
    {
      "id": 41,
      "model": "크로머언니",
      "content": "まぁ、それでもまだ途方に暮れるようなら…。"
    },
    {
      "id": 42,
      "model": "크로머언니",
      "content": "ここで…すくすく腐って、経験缶詰の材料になってね。\nこんな今のN社は、ゆっくりそのまま死んでいく方がいいだろうね。\n安楽死みたいに。"
    },
    {
      "id": 43,
      "model": "싱클레어",
      "content": "管理人さん…あの人を…いつから知っていたんですか？"
    },
    {
      "id": 44,
      "model": "단테",
      "content": "<ここに入ってから。\n初めて会ったのは、君たちと同じだよ。>"
    },
    {
      "id": 45,
      "model": "단테",
      "content": "<でも…みんなが経験したのに、\n私とムルソーだけが覚えていることがあるんだ。>"
    },
    {
      "id": 46,
      "model": "오티스",
      "content": "…我々に記憶の消去、\nあるいはそれに準ずる措置が施されたということですか？"
    },
    {
      "id": 47,
      "model": "단테",
      "content": "<…うん。>"
    },
    {
      "id": 48,
      "content": "私は囚人たちに、シーシュポス百貨店のおおまかなシステムと\nこれまでの結果について話した。"
    },
    {
      "id": 49,
      "content": "最初は私の頭がおかしくなったんじゃないかと、\n心配する眼差しも感じられたけれど…。"
    },
    {
      "id": 50,
      "content": "全てを話し終えたとき、囚人たちの目には信頼が宿っていた。"
    },
    {
      "id": 51,
      "model": "홍루",
      "content": "…本当にお疲れ様でした、ダンテさん。"
    },
    {
      "id": 52,
      "model": "오티스",
      "content": "これほどの重大事にお役に立てなかったとは…面目ありません。"
    },
    {
      "id": 53,
      "model": "이스마엘",
      "content": "トイレ…いえ、泉にいるあの人の言葉が本当なら、\nこれ、私たちにも秘密にしておくべきだったんですよね。"
    },
    {
      "id": 54,
      "model": "이스마엘",
      "content": "何か別の案でも思いついたんですか？"
    },
    {
      "id": 55,
      "model": "단테",
      "content": "<いや、そうじゃないけど…。>"
    },
    {
      "id": 56,
      "model": "단테",
      "content": "<それでも、別の方法を探して試してみないとね。>"
    },
    {
      "id": 57,
      "content": "私たちは百貨店で数多くの死を経験したけれど…。"
    },
    {
      "id": 58,
      "content": "反対に、百貨店にいる数多くの者たちの命を奪ってもきた。"
    },
    {
      "id": 59,
      "content": "そしてその中で時折…ある者たちの死を望まないかのように、姿を現す者がいた。"
    },
    {
      "id": 60,
      "model": "단테",
      "content": "<私たちが決められた道を外れようとするたびに…。>"
    },
    {
      "id": 61,
      "model": "단테",
      "content": "<元の場所に戻す者がいた。>"
    },
    {
      "id": 62,
      "model": "뫼르소",
      "content": "看守…のことですか。"
    },
    {
      "id": 63,
      "content": "囚人たちは誰一人、看守のことだけは覚えていなかった。"
    },
    {
      "id": 64,
      "content": "ということは、看守に殺されるのも…\n私の見た二つの結末と変わらないということではないだろうか。"
    },
    {
      "id": 65,
      "model": "단테",
      "content": "<全てが元の場所に戻った。\n範囲には違いがあるかもしれないけど、それは…。>"
    },
    {
      "id": 66,
      "model": "파우스트",
      "content": "…管理人様から伺った、在庫整理というものに似ているようですね。"
    },
    {
      "id": 67,
      "model": "오티스",
      "content": "在庫整理とは、管理人様のお話から察するに\n百貨店の缶詰生産量が基準に満たない場合に行われる、\n一種のハードリセットのように思えるが…。"
    },
    {
      "id": 68,
      "model": "오티스",
      "content": "ある個人の死にまで、似た現象が起きるとは…不気味だな。"
    },
    {
      "id": 69,
      "model": "단테",
      "content": "<百貨店が決めた道…。>"
    },
    {
      "id": 70,
      "model": "단테",
      "content": "<看守を、あの者を倒せるなら…。>"
    },
    {
      "id": 71,
      "model": "단테",
      "content": "<あの小さな在庫整理が起きず、別の選択ができるようになるんじゃないかな。>"
    },
    {
      "id": 72,
      "model": "뫼르소",
      "content": "容易い戦闘にはならないでしょう。"
    },
    {
      "id": 73,
      "model": "단테",
      "content": "<……。>"
    },
    {
      "id": 74,
      "model": "단테",
      "content": "<この選択も…答えじゃなかったらどうしよう？>"
    },
    {
      "id": 75,
      "model": "뫼르소",
      "content": "……。"
    },
    {
      "id": 76,
      "content": "ムルソーはどう答えたものかと、少しためらっているようだった。"
    },
    {
      "id": 77,
      "model": "뫼르소",
      "content": "管理人様。"
    },
    {
      "id": 78,
      "model": "뫼르소",
      "content": "もしや、怖いのですか？"
    },
    {
      "id": 79,
      "model": "단테",
      "content": "<…うん、もちろん。>"
    },
    {
      "id": 80,
      "model": "단테",
      "content": "<そうじゃなかったことなんてない。>"
    },
    {
      "id": 81,
      "model": "단테",
      "content": "<これからもそうだと思う。>"
    },
    {
      "id": 82,
      "model": "뫼르소",
      "content": "そうですか。"
    },
    {
      "id": 83,
      "model": "단테",
      "content": "<ムルソー、君は違うの？>"
    },
    {
      "id": 84,
      "model": "뫼르소",
      "content": "恐れは、現在を推し量ることから生まれます。ゆえに、\n今が正しいか間違っているかを考えるのをやめれば、\n確信を持たなければ…。"
    },
    {
      "id": 85,
      "model": "뫼르소",
      "content": "恐ろしくとも耐えられます。"
    },
    {
      "id": 86,
      "model": "뫼르소",
      "content": "そうなれば、ただ目の前のことだけに集中できます。"
    },
    {
      "id": 87,
      "model": "단테",
      "content": "<でも、そうしてたらそのうち…。>"
    },
    {
      "id": 88,
      "content": "そう語るムルソーに、私は何と答えればいいのか分からない。"
    },
    {
      "id": 89,
      "model": "단테",
      "content": "<…痛いことにも気づかなくなるんじゃない？>"
    },
    {
      "id": 90,
      "model": "뫼르소",
      "content": "鎖が拳をきつく包み覆っているため、\n傷を負っても痛みを少なくできます。"
    },
    {
      "id": 91,
      "model": "뫼르소",
      "content": "それもまた、私が鎖を鎧のように纏う理由です、管理人様。"
    },
    {
      "id": 92,
      "content": "恐れも、葛藤も見せなかったムルソーの態度は…。"
    },
    {
      "id": 93,
      "content": "時には馴染みのないものに思え、時には羨ましくもあった。"
    },
    {
      "id": 94,
      "content": "恐れのない人間は、様々な作戦を遂行する上で滞ることがなく\n楽そうにさえ見えたから。"
    },
    {
      "id": 95,
      "content": "けれど…。"
    },
    {
      "id": 96,
      "content": "だからといって、私たちがいつも恐れの中だけで過ごしていたわけではない。"
    },
    {
      "id": 97,
      "content": "最終的に作戦がうまくいったとき、苦難を乗り越えてついにやり遂げたとき…\n私たちは皆で喜んで勝利を分かち合い、\n必ず訪れる次の苦難を受け入れる準備をしていた。"
    },
    {
      "id": 98,
      "content": "その過程でも、ムルソーはいつも一歩退いていたのだ。"
    },
    {
      "id": 99,
      "content": "束の間の喜びも、休息も、共にできないまま。"
    },
    {
      "id": 100,
      "model": "단테",
      "content": "<私は…つらかったらつらいって感じるし、>"
    },
    {
      "id": 101,
      "model": "단테",
      "content": "<怖かったら怖いって言う。>"
    },
    {
      "id": 102,
      "model": "단테",
      "content": "<ただ…これからもそうする。>"
    },
    {
      "id": 103,
      "model": "뫼르소",
      "content": "そのような行為を通じて…有意に変わったことはありましたか？"
    },
    {
      "id": 104,
      "model": "단테",
      "content": "<…ない。>"
    },
    {
      "id": 105,
      "content": "みすぼらしい答えだった。"
    },
    {
      "id": 106,
      "model": "뫼르소",
      "content": "……。"
    },
    {
      "id": 107,
      "model": "단테",
      "content": "<ひとまず…2階へ向かおう。>"
    },
    {
      "id": 108,
      "content": "けれど、何も変わらないとしても、\n私たちは上り続けなければならなかった。"
    }
  ]
}
