{
  "dataList": [
    {
      "id": 0,
      "place": "???",
      "content": "看守の曲がった背が徐々に伸び…。"
    },
    {
      "id": 1,
      "content": "冷ややかな光が、次第に輝かしい黄金色へと染まっていく。"
    },
    {
      "id": 2
    },
    {
      "id": 3,
      "model": "신부거인",
      "content": "…百貨店で背筋を伸ばすのは、いつぶりか分からないな。"
    },
    {
      "id": 4,
      "model": "단테",
      "content": "<雰囲気が変わった。>"
    },
    {
      "id": 5,
      "model": "신부거인",
      "content": "はぁ…罪人ムルソーと…リンバス・カンパニーの管理人ダンテ…\nそして、その仲間たちだったか。"
    },
    {
      "id": 6,
      "model": "단테",
      "content": "<……。>"
    },
    {
      "id": 7,
      "model": "파우스트",
      "content": "あなたは…どなたですか？"
    },
    {
      "id": 8,
      "model": "신부거인",
      "content": "あぁ…紹介が遅れたな。私はル・ノワールが従う黒き神の声であり…シーシュポス刑に\n処された罪人を監視する看守であり…シーシュポス百貨店の巨人の一人。"
    },
    {
      "id": 9,
      "model": "신부거인",
      "content": "いや、こうしているより名刺でも渡した方がよさそうだ。\nさぁ、受け取ってくれ。"
    },
    {
      "id": 10,
      "content": "看守…だった者が軽く手を動かすと\n私たちの前に名刺が一枚、ひらひらと落ちてきた。"
    },
    {
      "id": 11,
      "content": "ごく普通の名刺には、\nN社シーシュポス百貨店の巨人という肩書きと…名前が記されていた。"
    },
    {
      "id": 12,
      "model": "뫼르소",
      "content": "…司祭モーリス。"
    },
    {
      "id": 13,
      "model": "신부거인",
      "content": "司祭とだけ呼んでくれ。お前の母も、そう呼んでいたからな。"
    },
    {
      "id": 14,
      "model": "단테",
      "content": "<……。>"
    },
    {
      "id": 15,
      "model": "오티스",
      "content": "何の理由もなく本来の姿を現したわけではないだろう…警告でもしに来たのか？"
    },
    {
      "id": 16,
      "model": "신부거인",
      "content": "警告の段階など、とうに過ぎたのではないか。"
    },
    {
      "id": 17,
      "model": "신부거인",
      "content": "殺して送り返したところで、諦める人たちにも見えないし…。"
    },
    {
      "id": 18,
      "model": "신부거인",
      "content": "何が何だか知らないが、シーシュポスシステムが白夜、黒昼以来\nイカれたせいか…君たちのような、規則から外れた目の上のたんこぶまで出てきた。"
    },
    {
      "id": 19,
      "model": "신부거인",
      "content": "だから、どこかに永遠に閉じ込めようと来たんだ。"
    },
    {
      "id": 20,
      "model": "싱클레어",
      "content": "永遠に…ですか？"
    },
    {
      "id": 21,
      "model": "신부거인",
      "content": "シーシュポス刑に処されたからには、ここの規律に忠実に従い、\n自らの罪を懺悔して生きても足りぬというのに…。"
    },
    {
      "id": 22,
      "model": "신부거인",
      "content": "何度もそうして規律を破り、勝手に振る舞うならば…\n罪人の誠意を疑わざるを得ぬではないか…！ということさ。"
    },
    {
      "id": 23,
      "model": "홍루",
      "content": "僕たちが規律を破り、ムルソーさんと一緒に\n百貨店を出ようとしたからなんですね。"
    },
    {
      "id": 24,
      "model": "신부거인",
      "content": "はっ。実のところ、罪人と一緒に君たちが百貨店を出るのは構わない。\nそれが可能かは分からないが。"
    },
    {
      "id": 25,
      "model": "신부거인",
      "content": "だが、君たちが運命…シーシュポスシステムにまで逆らい始めた瞬間…\nシーシュポス百貨店で生産される経験の生地の品質と生産量に、多大な問題が生じる。"
    },
    {
      "id": 26,
      "model": "신부거인",
      "content": "怖くないのか？N社が築いた規律や真理が崩れることが。"
    },
    {
      "id": 27,
      "model": "신부거인",
      "content": "規律が崩れたあとには、野蛮が残るだろう。"
    },
    {
      "id": 28,
      "model": "신부거인",
      "content": "そうなればN社はまた昔のように、あらゆる裏路地、\nあらゆる巣の人々の脳を釘でほじくり、直接経験を得ようとするだろう。"
    },
    {
      "id": 29,
      "model": "싱클레어",
      "content": "……。"
    },
    {
      "id": 30,
      "model": "신부거인",
      "content": "ゆえに…シーシュポスシステムの規律に従い、\n巨人殺しのムルソーを隔離する。"
    },
    {
      "id": 31,
      "model": "신부거인",
      "content": "…悔い改めた頃に、また会おう。"
    },
    {
      "id": 32,
      "model": "단테",
      "content": "<ま、待って…！>"
    },
    {
      "id": 33,
      "model": "그레고르",
      "content": "おぉ…？"
    },
    {
      "id": 34,
      "model": "뫼르소엄마",
      "content": "部屋の扉を閉めてちょうだい、ムルソー。\n陽の光一つ入らないように。視線一つ入らないように。"
    },
    {
      "id": 35,
      "model": "신부거인",
      "content": "<color=#7d7d7d>自分がその手で、どんな罪を犯したか…思い出すがいい。</color>"
    },
    {
      "id": 36,
      "model": "뫼르소엄마",
      "content": "かっ…かはっ…。"
    },
    {
      "id": 37,
      "model": "뫼르소",
      "content": "……。"
    },
    {
      "id": 38,
      "model": "뫼르소",
      "content": "私は母を殺した。"
    },
    {
      "id": 39,
      "model": "신부거인",
      "content": "<color=#7d7d7d>若気の至り…そんな言葉で取り繕える事件ではないだろう？\nいくら好意的に見ようとしても。常識的におかしいだろう。</color>"
    },
    {
      "id": 40,
      "model": "신부거인",
      "content": "<color=#7d7d7d>君のしたことによって、N社はまさに取り返しのつかない結果を迎えたからな。</color>"
    },
    {
      "id": 41,
      "model": "신부거인",
      "content": "<color=#7d7d7d>皆、驚いたよ。自らの母親を、あれほど無慈悲な方法で殺害した…君の非人間性に。</color>"
    },
    {
      "id": 42,
      "model": "신부거인",
      "content": "<color=#7d7d7d>君を閉じ込めるのは、監獄でも…シーシュポス百貨店でもないだろう。</color>"
    },
    {
      "id": 43,
      "model": "신부거인",
      "content": "<color=#7d7d7d>罪人は、罪によって閉じ込められるだけだ。ここに囚われ、\n自らの罪を余すところなく直視し、後悔し、悔い改めるべきではないか？</color>"
    },
    {
      "id": 44,
      "model": "뫼르소",
      "content": "母の帰宅はおおむね7時10分頃、私の帰宅はそれより少し早い18時だ。"
    },
    {
      "id": 45,
      "model": "뫼르소",
      "content": "先に帰宅した私は、換気のために開けておいた全ての窓を閉める。"
    },
    {
      "id": 46,
      "model": "뫼르소",
      "content": "そのあとは、真っ黒なカーテンで外の景色を覆う。"
    },
    {
      "id": 47,
      "model": "과거뫼르소",
      "content": "お帰りなさい、お母様。"
    },
    {
      "id": 48,
      "model": "뫼르소엄마안경",
      "content": "…窓とカーテンは、残らず閉めた？"
    },
    {
      "id": 49,
      "model": "과거뫼르소",
      "content": "はい。"
    },
    {
      "id": 50,
      "model": "뫼르소",
      "content": "母は世界を、他人の視線を恐れていた。"
    },
    {
      "id": 51,
      "model": "뫼르소",
      "content": "外出するときには必ずサングラスをかけ、\n道を歩くときにはいつもうつむき、地面ばかりを見ていた。"
    },
    {
      "id": 52,
      "model": "뫼르소",
      "content": "19時30分、母と共に夕食を摂る。"
    },
    {
      "id": 53,
      "model": "뫼르소엄마",
      "teller": "母",
      "content": "覚えておいて、あの眼差しを。\nあの人たちは悪意を持って私を見ているのではないでしょうけれど…。"
    },
    {
      "id": 54,
      "model": "뫼르소엄마",
      "teller": "母",
      "content": "一度視線に収められると…その人の脳に、\n私はそのまま釘付けにされ、固定されるの。"
    },
    {
      "id": 55,
      "model": "뫼르소엄마",
      "teller": "母",
      "content": "私という存在が…そうやって奪われ、\n固定されて、勝手に記憶されるのよ。"
    },
    {
      "id": 56,
      "model": "뫼르소엄마",
      "teller": "母",
      "content": "あぁ、恐ろしい…考えるだけでも恐ろしくて、耐えられない。"
    },
    {
      "id": 57,
      "model": "뫼르소",
      "content": "母はあらゆる日常で、一日の中で苦しかったことを吐露する。"
    },
    {
      "id": 58,
      "model": "뫼르소엄마",
      "teller": "母",
      "content": "誰かの視線に囚われると…私たちは…そのまま固定されるほかないの。"
    },
    {
      "id": 59,
      "model": "뫼르소엄마",
      "teller": "母",
      "content": "今日すれ違った大勢の人たちが…私たちのように家で、夕食の経験缶詰を食べるでしょう…\nそうして、その人の記憶に剥製にされたあなたの存在が、ふと浮かぶとき…\nあなたは存在せざるを得なくなるの。自分が望みもしなかった形で…。"
    },
    {
      "id": 60,
      "model": "뫼르소엄마",
      "teller": "母",
      "content": "怖い…ムルソー、でもあなただけは、怖がらずにいられたらいいのに…\nあぁ…でも、本当にそんなことができるのかしら…。"
    },
    {
      "id": 61,
      "model": "뫼르소",
      "content": "いつものように、母の絶望は自らに向けた言葉へと行き着く。"
    },
    {
      "id": 62,
      "model": "뫼르소",
      "content": "私は母の言葉を全て傾聴するが、何に対しても答えない。"
    },
    {
      "id": 63,
      "model": "뫼르소",
      "content": "ただ家族らしく、息子らしく…食事を用意し、共に経験缶詰を食べる。"
    },
    {
      "id": 64,
      "model": "뫼르소",
      "content": "缶詰の中には、絶望も恐れもない。"
    },
    {
      "id": 65,
      "model": "뫼르소",
      "content": "私と母は平和で、心地よく、和やかな夕べを過ごす。"
    },
    {
      "id": 66,
      "model": "뫼르소",
      "content": "母は居間の最も目につく場所に、長く重い鎖を掛けていた。"
    },
    {
      "id": 67,
      "model": "뫼르소",
      "content": "それは私と母の…私たちの恐れを和らげる象徴であり、指標だった。"
    },
    {
      "id": 68,
      "model": "뫼르소엄마",
      "teller": "母",
      "content": "ムルソー、お母さんは家にあるこの鎖を見て\nいつも思い出し、気をつけているの。"
    },
    {
      "id": 69,
      "model": "뫼르소엄마",
      "teller": "母",
      "content": "外に、人々の存在を感じるでしょう？\nここを見ているのかも分からないまま、見ている人々の存在を。"
    },
    {
      "id": 70,
      "model": "뫼르소엄마",
      "teller": "母",
      "content": "お母さんはね…この感覚に、\n生涯全身を締めつけながら生きてきたの。"
    },
    {
      "id": 71,
      "model": "뫼르소엄마",
      "teller": "母",
      "content": "だから、どこであっても人々がいると怖いの。"
    },
    {
      "id": 72,
      "model": "뫼르소엄마",
      "teller": "母",
      "content": "勝手に私を記憶して期待しては、食い違ってしまう…。"
    },
    {
      "id": 73,
      "model": "뫼르소엄마",
      "teller": "母",
      "content": "その全てが私を重くして、怖がらせるの。"
    },
    {
      "id": 74,
      "model": "뫼르소엄마",
      "teller": "母",
      "content": "それぞれが私の身体に無理やり鎖を結びつけて、\n手足を全部引きちぎっていくような気分よ。"
    },
    {
      "id": 75,
      "model": "뫼르소",
      "content": "母は痛がっていた。ちぎれていない手足が\n余すことなく、ちぎられていく痛みを感じた。"
    },
    {
      "id": 76,
      "model": "과거뫼르소",
      "content": "……。"
    },
    {
      "id": 77,
      "model": "과거뫼르소",
      "content": "では…引きちぎられる痛みには\nどう堪えるのですか、お母様。"
    },
    {
      "id": 78,
      "model": "뫼르소",
      "content": "その問いに母は安堵の表情を浮かべ、\nまるで私たちを唯一救ってくれる、神聖な何かを見るように…。"
    },
    {
      "id": 79,
      "model": "뫼르소",
      "content": "家の中に掛かる鎖を指した。"
    },
    {
      "id": 80,
      "model": "뫼르소엄마",
      "teller": "母",
      "content": "他の人の鎖に縛られる前に、あらかじめ鎖を巻いておくの。"
    },
    {
      "id": 81,
      "model": "뫼르소엄마",
      "teller": "母",
      "content": "鎖に巻かれれば動けなくても…\n少なくとも、痛い思いをせずに済むでしょう。"
    },
    {
      "id": 82,
      "model": "뫼르소엄마",
      "teller": "母",
      "content": "それはあなたの皮膚に代わって、\n痛みを防ぐ鎧になってくれるだろうから…。"
    },
    {
      "id": 83,
      "model": "뫼르소엄마",
      "teller": "母",
      "content": "釘と金鎚だけが、何かを固定できるというわ。\nでも、私にはそうではないの。\n鎖でも縛り、固定できるのよ。そう信じるのよ。"
    },
    {
      "id": 84,
      "model": "뫼르소",
      "content": "それは信じなければならない、に近かったのだろう。\n母はそれほど切迫して見えたから。"
    },
    {
      "id": 85,
      "model": "신부거인",
      "content": "<color=#7d7d7d>…直視し続けよ。罪人の恐れを。</color>"
    },
    {
      "id": 86,
      "model": "뫼르소엄마",
      "teller": "母",
      "content": "部屋の扉を…。"
    },
    {
      "id": 87,
      "model": "뫼르소엄마",
      "teller": "母",
      "content": "部屋の扉を閉めてちょうだい、ムルソー。\n陽の光一つ入らないように。視線一つ入らないように。\n誰も入らず、誰にも見つめられてしまわないように。"
    },
    {
      "id": 88,
      "model": "뫼르소",
      "content": "母が必ず持つ時間があった。一人で部屋に入り、扉を閉める時間。"
    },
    {
      "id": 89,
      "model": "뫼르소",
      "content": "中で何をしているのかは知らなかった。だが、\n中に入っている母を見守るのは、私にとって恐ろしいことだった。"
    },
    {
      "id": 90,
      "model": "뫼르소",
      "content": "父が去ってから、その時間はさらに長くなった。\n母は必ず一人で部屋にいる時間がなければ…生きることに耐えられないと言った。"
    },
    {
      "id": 91,
      "model": "뫼르소",
      "content": "そして、その間は例外なく誰も部屋に入れないようにした。"
    },
    {
      "id": 92,
      "model": "뫼르소",
      "content": "……。"
    },
    {
      "id": 93,
      "model": "신부거인",
      "content": "<color=#7d7d7d>…直視し続けよ。罪人の恐怖を。</color>"
    },
    {
      "id": 94,
      "model": "뫼르소",
      "content": "母はその中で何をしているのか。\n何が母を、そのつらさの中で耐えられるようにしているのか。"
    },
    {
      "id": 95,
      "model": "뫼르소",
      "content": "それは好奇心ではなかった。"
    },
    {
      "id": 96,
      "model": "뫼르소",
      "content": "心配であり、"
    },
    {
      "id": 97,
      "model": "뫼르소",
      "content": "恐れだった。"
    },
    {
      "id": 98,
      "model": "뫼르소",
      "content": "母が中でおかしくなっているわけではないという確信と、\n安心が私には必要だった。"
    },
    {
      "id": 99,
      "model": "뫼르소",
      "content": "だから…。"
    },
    {
      "id": 100,
      "model": "뫼르소엄마아픔",
      "teller": "母",
      "content": "どうして？どうして！！！！"
    },
    {
      "id": 101,
      "model": "뫼르소엄마아픔",
      "teller": "母",
      "content": "怖い！怖くてたまらない！！"
    },
    {
      "id": 102,
      "place": "???",
      "model": "뫼르소",
      "content": "あの出来事以来、私は母を見つめようとしなかった。"
    },
    {
      "id": 103,
      "model": "뫼르소",
      "content": "母の一人きりの安息を、守って差し上げなければならなかった。"
    },
    {
      "id": 104,
      "model": "뫼르소",
      "content": "そうでなければ、私が釘となり、金鎚となり\n鎖となって母を締めつけてしまい、"
    },
    {
      "id": 105,
      "model": "뫼르소",
      "content": "それは私が望もうと望むまいと、起きることなのだから。"
    },
    {
      "id": 106,
      "model": "뫼르소엄마",
      "teller": "母",
      "content": "部屋の扉を…閉めてちょうだい…ムルソー…。"
    },
    {
