        {
            "id": 0,
            "place": "7F 明室",
            "model": "잔느변신",
            "content": "袮還是……不想做出判断麼。不管是対陽光，還是対這百貨店。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 1,
            "model": "잔느변신",
            "content": "這里就是百貨店的終点了。无論如何爭扎，都是无法从這里出去的。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 2,
            "model": "잔느변신",
            "content": "可為什么要反反復復地……嘗試其他選擇捏？我很好奇啊。袮的目的究竟是什么捏。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 3,
            "content": "雖然我們所有人都能听到譲娜的話……但那些話語都只在対默尓索一人訴説。"
        },
        {
            "id": 4,
            "content": "默尓索似乎閉上眼沈思了片刻，随后睜眼瞥向我和罪人們所在的地方。"
        },
        {
            "id": 5,
            "model": "뫼르소",
            "content": "……為了譲他們从這里出去。",
            "teller": "默尓索",
            "title": "5号罪人"
        },
        {
            "id": 6,
            "model": "잔느변신",
            "content": "哈。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 7,
            "model": "잔느변신",
            "content": "在進入袮的日常之前，我観察了袮很久。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 8,
            "model": "잔느변신",
            "content": "小可愛。那不是袮的判断，袮以為我看不出来麼？",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 9,
            "model": "뫼르소",
            "content": "……",
            "teller": "默尓索",
            "title": "5号罪人"
        },
        {
            "id": 10,
            "model": "잔느변신",
            "content": "不管是飄蕩的气息，深埋進地下的樹根，不知何時放下的巨石，曾是花草的東西。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 11,
            "model": "잔느변신",
            "content": "還是渴望去展現什么，渴望去尋找意義的人們，或是這座都市。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 12,
            "model": "잔느변신",
            "content": "全都……不過是在漫无目的地漂流。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 13,
            "model": "잔느변신",
            "content": "因為確信袮是感受了那一切，經驗了那一切的人……那天，我才向袮搭了話。",
            "teller": "譲娜",
            "title": "巨人"
        }
    ]
