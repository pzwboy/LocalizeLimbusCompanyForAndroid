{
  "dataList": [
    {
      "id": 0,
      "place": "7F 明るい部屋",
      "content": "不合理な舞台。"
    },
    {
      "id": 1,
      "content": "その上で、まともな役柄すら与えられぬまま\nムルソーは際限なく押しやられている。"
    },
    {
      "id": 2,
      "content": "真っ暗な闇の中で、\n私は押しやられるムルソーを見つめることしかできない。"
    },
    {
      "id": 3,
      "content": "その途方に暮れる思いに、\n何も答えてくれない闇の中の静寂に、疲れた頃…。"
    },
    {
      "id": 4,
      "content": "陽射しが私に近づいてきた。"
    },
    {
      "id": 5,
      "place": "???",
      "model": "카르멘진짜",
      "content": "深く悩んでいるようね、ダンテ。"
    },
    {
      "id": 6,
      "model": "단테",
      "content": "<……。>"
    },
    {
      "id": 7,
      "model": "카르멘진짜",
      "content": "それとも、怖いの？\nこれから続く、選択の瞬間が。"
    },
    {
      "id": 8,
      "content": "ムルソーは、陽射しと話すな、\n長く見つめるなと警告したけれど…。"
    },
    {
      "id": 9,
      "content": "もどかしく、途方に暮れたときに聞こえる…\n温かな声に答えないのは、あまりに難しいことだった。"
    },
    {
      "id": 10,
      "model": "단테",
      "content": "<…うん。>"
    },
    {
      "id": 11,
      "model": "단테",
      "content": "<あなたと違って、私には…何一つ分からないから…怖い。>"
    },
    {
      "id": 12,
      "model": "카르멘진짜",
      "content": "う～ん…どこまで話してあげるべきか分からないけれど…。"
    },
    {
      "id": 13,
      "model": "카르멘진짜",
      "content": "私も…あなたと変わらなかったわ、ダンテ。"
    },
    {
      "id": 14,
      "model": "카르멘진짜",
      "content": "私は…この都市の規則の上に、\n新しい規則を積み上げようと努めたの。"
    },
    {
      "id": 15,
      "model": "카르멘진짜",
      "content": "そんな中で、外郭から来た二人の子どもに出会ったわ。"
    },
    {
      "id": 16,
      "model": "카르멘진짜",
      "content": "そのうちの一人は…人の姿をしていたけれど、■■■■■…。"
    },
    {
      "id": 17,
      "model": "단테",
      "content": "<今の言葉は…。>"
    },
    {
      "id": 18,
      "model": "카르멘진짜",
      "content": "ふふっ。毎回あなたに話すたび、分からなくなってしまうみたい。\nどこから…どこまで話していいか、ということをね。"
    },
    {
      "id": 19,
      "model": "카르멘진짜",
      "content": "ともかく私は、外郭で出会った特別な子を\n実験に使わなくちゃならなかったの。"
    },
    {
      "id": 20,
      "model": "카르멘진짜",
      "content": "あの子を犠牲にしなきゃ…特異点を掴めなかったから。"
    },
    {
      "id": 21,
      "model": "카르멘진짜",
      "content": "でも、私の価値観では…子どもを犠牲にすることは受け入れられなかったわ。\nたとえ星を繋ぐためだったとしてもね。"
    },
    {
      "id": 22,
      "model": "카르멘진짜",
      "content": "今でこそ…私の望み通りに世界を塗ったけれど…\nあの頃は本当に怖かったんだ。"
    },
    {
      "id": 23,
      "model": "카르멘진짜",
      "content": "ただ規則を作れば済むわけじゃないの。\n既存の規則を守ろうとする人たちに…\n立ち向かわなくちゃならなかったから…。"
    },
    {
      "id": 24,
      "model": "카르멘진짜",
      "content": "私だけじゃなく、私についてきた仲間たちも皆\nそう感じていたはず。"
    },
    {
      "id": 25,
      "model": "카르멘진짜",
      "content": "いつ死ぬか分からない。"
    },
    {
      "id": 26,
      "model": "카르멘진짜",
      "content": "これまで注いできた努力が、水の泡になるかもしれない。"
    },
    {
      "id": 27,
      "model": "카르멘진짜",
      "content": "失敗したら、帰る場所もないのに…。"
    },
    {
      "id": 28,
      "model": "카르멘진짜",
      "content": "これが本当に実現するのか、信じる気持ちは次第に薄れていったわ。"
    },
    {
      "id": 29,
      "model": "카르멘진짜",
      "content": "そうしていると、ふと考えるの。"
    },
    {
      "id": 30,
      "model": "카르멘진짜",
      "content": "この全てに、何の価値があるんだろう？"
    },
    {
      "id": 31,
      "model": "카르멘진짜",
      "content": "どう、ダンテ。\nあなたが考えていることと…似ていない？"
    },
    {
      "id": 32,
      "model": "단테",
      "content": "<…似てる。いや、同じだ。>"
    },
    {
      "id": 33,
      "content": "この旅を始めてから、絶えず抱いていた悩みだ。"
    },
    {
      "id": 34,
      "content": "その不安を全て背負い、ここまで来てもなお…減らない不安だ。"
    },
    {
      "id": 35,
      "model": "카르멘진짜",
      "content": "あなたにとって、ムルソーはどんな人？"
    },
    {
      "id": 36,
      "model": "단테",
      "content": "<囚人…だろうね。>"
    },
    {
      "id": 37,
      "model": "단테",
      "content": "<N社で生きてきて、それから追放されて…\n私に助言を惜しまず、記憶力がよくて…。>"
    },
    {
      "id": 38,
      "model": "단테",
      "content": "<……。>"
    },
    {
      "id": 39,
      "content": "これじゃ、ムルソーはいつものように\n見つめられてしまっている。"
    },
    {
      "id": 40,
      "content": "それじゃ…助けられない。手を握ってあげられない。"
    },
    {
      "id": 41,
      "content": "ならば、私には何ができるだろう。"
    },
    {
      "id": 42,
      "content": "この全てのことに…そうするだけの価値があるのかも知らないまま、\n何ができるんだろう。"
    },
    {
      "id": 43,
      "model": "단테",
      "content": "<あなたは…その不安に、どうやって耐えたの？>"
    },
    {
      "id": 44,
      "model": "카르멘진짜",
      "content": "…私は耐えられなかったわ、ダンテ。"
    },
    {
      "id": 45,
      "model": "카르멘진짜",
      "content": "その全ての視線が、銛のように…あまりに痛く、\n私の心に突き刺さって…。"
    },
    {
      "id": 46,
      "model": "카르멘진짜",
      "content": "一人の子が死んだのに、その罪悪感でさえ進めない私たちは、\n背中を押される私は…。"
    },
    {
      "id": 47,
      "model": "카르멘진짜",
      "content": "結局、耐える代わりに選択するしかなかったの。"
    },
    {
      "id": 48,
      "model": "단테",
      "content": "<何を選択したの？>"
    },
    {
      "id": 49,
      "model": "카르멘진짜",
      "content": "自分自身を使って、プロジェクトを完成させようとしたの。"
    },
    {
      "id": 50,
      "model": "카르멘진짜",
      "content": "自分を捨て、犠牲にして成し遂げさせようとした。"
    },
    {
      "id": 51,
      "model": "카르멘진짜",
      "content": "あの子を通して掴んだ特異点は…\n私からしか取り出せなかったから。"
    },
    {
      "id": 52,
      "model": "카르멘진짜",
      "content": "その全ての罪の意識を、\n罪悪感を抱いて…生を手放そうと決意して…。"
    },
    {
      "id": 53,
      "model": "카르멘진짜",
      "content": "浴槽の中に沈んで…。"
    },
    {
      "id": 54,
      "model": "카르멘진짜",
      "content": "ゆっくりと目を閉じると…。"
    },
    {
      "id": 55,
      "model": "카르멘진짜",
      "content": "途方もない恐怖が訪れたの。\nそれは…それまでに感じた、どんな絶望とも違うものだったわ。"
    },
    {
      "id": 56,
      "model": "카르멘진짜",
      "content": "生へと向けた…絶叫だったの。"
    },
    {
      "id": 57,
      "model": "단테",
      "content": "<死にたくなかったんだね。>"
    },
    {
      "id": 58,
      "model": "카르멘진짜",
      "content": "……。"
    },
    {
      "id": 59,
      "model": "카르멘진짜",
      "content": "実際、馴染みないように見えても\nムルソーとジャンヌも私と変わらないでしょう。"
    },
    {
      "id": 60,
      "model": "카르멘진짜",
      "content": "どこにも受け容れられない者たちが、\nもどかしさに絶叫しているの。"
    },
    {
      "id": 61,
      "model": "카르멘진짜",
      "content": "程度が違うだけで、都市の人は皆そうじゃないかしら？"
    },
    {
      "id": 62,
      "model": "카르멘진짜",
      "content": "世界から忘れられ、押しやられて\n息が止まってしまわないように。"
    },
    {
      "id": 63,
      "model": "카르멘진짜",
      "content": "ダンテ。あなたはムルソーに、何をしてあげられるかしら。"
    },
    {
      "id": 64,
      "model": "카르멘진짜",
      "content": "あなたはどんな存在だから、あの人たちを導いているのかしら。"
    },
    {
      "id": 65,
      "model": "단테",
      "content": "<…ただ、足掻くことしかできないだろうね。>"
    },
    {
      "id": 66,
      "model": "단테",
      "content": "<この先に何があるのかも分からず、不安を感じながら…。>"
    },
    {
      "id": 67,
      "content": "ならば、私は誰だろう。私は何だろう。"
    },
    {
      "id": 68,
      "content": "囚人たちを導く管理人…一年前、望みもせず\nいきなり受け入れたその呼称が…本当に私で在り得るのだろうか。"
    },
    {
      "id": 69,
      "content": "ドンキホーテの家族。良秀の友人。グレゴールの戦友、ウーティスの上官、\nホンルの仲間、シンクレアの大人、ヒースクリフの理解者、イシュメールの羅針盤、\nイサンの朋、ファウストの、ロージャの、ヴェルギリウスの、カロンの、ムルソーの…。"
    },
    {
      "id": 70,
      "content": "浮かんでくる私についての全ては…他人の視線でできている。"
    },
    {
      "id": 71,
      "content": "ならば、その視線を全て剥ぎ取った私には、何が残るのか。"
    },
    {
      "id": 72,
      "content": "私は他人を離れ、何によって自分の存在を証明できるのか。"
    },
    {
      "id": 73,
      "content": "私の全ての視線を剥ぎ取ったムルソーに…。"
    },
    {
      "id": 74,
      "content": "あの存在に、何が残るのか。"
    },
    {
      "id": 75,
      "content": "何が、あの者を存在させるのか。"
    },
    {
      "id": 76,
      "place": "7F 明るい部屋",
      "model": "단테",
      "content": "<……。>"
    },
    {
      "id": 77,
      "model": "뫼르소다침",
      "content": "……。"
    },
    {
      "id": 78,
      "content": "視線が合った。"
    },
    {
      "id": 79,
      "content": "冷静でありながら、同時に情熱を宿す眼差しを見て…私は手も伸ばさず、\n口を開いて自分の考えを言葉にすることもしなかった。"
    },
    {
      "id": 80,
      "content": "ただ、あの存在に対する期待を抱くだけ。"
    }
  ]
