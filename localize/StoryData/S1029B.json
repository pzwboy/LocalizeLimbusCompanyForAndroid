{
  "dataList": [
    {
      "id": 1,
      "place": "5階 レストラン",
      "content": "ついに…隙間が裂け、そこから\nプイであるはずのものが歩み出てきた。"
    },
    {
      "id": 2,
      "content": "その姿は巨大で威厳があり、ル・ルージュたちが呼んでいた\n神や王のような風格が感じられる。"
    },
    {
      "id": 3,
      "model": "뷔페어른",
      "teller": "プイ？",
      "content": "……。"
    },
    {
      "id": 4,
      "model": "뷔페어른",
      "teller": "プイ？",
      "content": "まだ…傍にいてくれたのか…。"
    },
    {
      "id": 5,
      "model": "이상",
      "content": "…変わりしな、プイ君。眠りは…安らかでありしや？"
    },
    {
      "id": 6,
      "model": "뷔페어른",
      "teller": "プイ？",
      "content": "安らかだった。夢も…見た。"
    },
    {
      "id": 7,
      "model": "그레고르",
      "content": "そりゃよかったな、うん。それはそうと…\n今どきの子はぐんぐん育つっていうが…見違えるほど大きくなってるな？"
    },
    {
      "id": 8,
      "model": "단테",
      "content": "<そうだね…めちゃくちゃ成長した。>"
    },
    {
      "id": 9,
      "model": "뷔페어른",
      "teller": "プイ？",
      "content": "…夢を見ながら、私は自分の名前をちゃんと言えるようになった。"
    },
    {
      "id": 10,
      "model": "뷔페어른",
      "teller": "プイ？",
      "content": "最後まで口にできなかった、私の名前。"
    },
    {
      "id": 11,
      "model": "뷔페어른",
      "content": "ビュッフェ…ビュッフェで十分だろう。"
    },
    {
      "id": 12,
      "model": "이상",
      "content": "…ブイフェと、いまだ発音も拙きままに言いしゆえ、\n頭の文字のみを口にすることとなりしものなり。"
    },
    {
      "id": 13,
      "model": "그레고르",
      "content": "へぇ…まぁ、よかったな。こんなに大きくなったのに、\nあんまり可愛いあだ名ってのもアレだろ。"
    },
    {
      "id": 14,
      "model": "뷔페어른",
      "content": "……。"
    },
    {
      "id": 15,
      "model": "뫼르소",
      "content": "私たちはこれから、6階へ上るエスカレーターを探す。"
    },
    {
      "id": 16,
      "model": "뫼르소",
      "content": "ビュッフェ。お前は…何をしたいのか、尋ねたい。"
    },
    {
      "id": 17,
      "model": "뷔페어른",
      "content": "私は…。"
    },
    {
      "id": 18,
      "model": "뷔페어른",
      "content": "私は、飢えたものたちが欲望で形作った存在。"
    },
    {
      "id": 19,
      "model": "뷔페어른",
      "content": "生まれる前から、私は飢えと渇きに苦しんでいた。"
    },
    {
      "id": 20,
      "model": "뷔페어른",
      "content": "でも…これは私のものじゃない。"
    },
    {
      "id": 21,
      "model": "뷔페어른",
      "content": "私を成す糸の一本一本が全部…誰かの飢えによって形作られた願いだったんだ。\nそれとも、他人の夢…と言うべきなのかな？"
    },
    {
      "id": 22,
      "model": "뷔페어른",
      "content": "その底なしの飢えで、私は作られた。"
    },
    {
      "id": 23,
      "model": "뫼르소",
      "content": "…ここはレストランだ。"
    },
    {
      "id": 24,
      "model": "뫼르소",
      "content": "席に着いて待てば…飢えを満たす食事ができるだろう。"
    },
    {
      "id": 25,
      "model": "뷔페어른",
      "content": "…いや。食事では、この空っぽのお腹を満たせない。"
    },
    {
      "id": 26,
      "model": "뷔페어른",
      "content": "この飢えに終わりはないだろうから。"
    },
    {
      "id": 27,
      "model": "뷔페어른",
      "content": "だから…もう待つことはない。順番もなくなるだろう。"
    },
    {
      "id": 28,
      "model": "단테",
      "content": "<……。>"
    },
    {
      "id": 29,
      "model": "뷔페어른",
      "content": "…君たちも一緒にいよう。上に行かなくていい。"
    },
    {
      "id": 30,
      "model": "뷔페어른",
      "content": "渇きが芽生える前に満たし続ければ…\nここではもう、遠くを望む必要もなくなるだろうから。"
    },
    {
      "id": 31,
      "model": "이상",
      "content": "それはいかなる……。"
    }
  ]
}
