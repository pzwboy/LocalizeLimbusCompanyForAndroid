{
  "dataList": [
    {
      "id": 0,
      "place": "7F 明るい部屋",
      "model": "잔느변신2",
      "content": "N社の秩序、規則、経験缶詰は、羽々が\nさほど悩まずに生きられるようにする。"
    },
    {
      "id": 1,
      "model": "잔느변신2",
      "content": "でも私たちにとって、外はまともな安息の場ではないわ。"
    },
    {
      "id": 2,
      "model": "잔느변신2",
      "content": "生きている生の場所ではなく、分類され、\n固定されたものたちが、自らを展示する場所に過ぎない。"
    },
    {
      "id": 3,
      "model": "잔느변신2",
      "content": "これから人々はここで…\nこの不条理と、不快な感覚を感じるでしょう。"
    },
    {
      "id": 4,
      "model": "잔느변신2",
      "content": "分かる？"
    },
    {
      "id": 5,
      "model": "잔느변신2",
      "content": "これからは、あなたの見る世界に\n人々が合わせられるのよ！"
    },
    {
      "id": 6,
      "model": "잔느변신2",
      "content": "もうN社の経験缶詰を\n生産するための手段である必要もない。"
    },
    {
      "id": 7,
      "model": "잔느변신2",
      "content": "これ自体が、美しい私たちの船となって…漂っていける。\nもう巻き戻しもない。この中で、ずっと自由に生きていくの。\n自分たちが望む姿で、私たちが作ってあげた意味の中で！"
    },
    {
      "id": 8,
      "model": "잔느변신2",
      "content": "あなたと私が一緒なら…できることよ。\n互いを理解し合う、唯一の伴侶同士で。"
    },
    {
      "id": 9,
      "model": "잔느변신2",
      "content": "あぁ、想像するだけで…胸が高鳴らない？"
    },
    {
      "id": 10,
      "model": "뫼르소다침",
      "content": "…それでも、恐ろしいだろう。"
    },
    {
      "id": 11,
      "model": "잔느변신2",
      "content": "いいえ、恐ろしくはないわ。"
    },
    {
      "id": 12,
      "model": "잔느변신2",
      "content": "このシーシュポスは…私たちが作ったもので、\n私たちにできることよ。"
    },
    {
      "id": 13,
      "model": "잔느변신2",
      "content": "その自由の中で、シーシュポスは\n存在理由の明確な世界に生まれ変わるわ。"
    },
    {
      "id": 14,
      "model": "잔느변신2",
      "content": "私たちにはただよそよそしかった世界が…\nもう何の理由もなく置かれたままではなくなるの。"
    },
    {
      "id": 15,
      "model": "뫼르소다침",
      "content": "ジャンヌ…世界は決して変わらない。\nだから合理的ではなく、私たちに無関心だ。"
    },
    {
      "id": 16,
      "model": "뫼르소다침",
      "content": "君の言う通りに作られるシーシュポスシネマは…。"
    },
    {
      "id": 17,
      "model": "뫼르소다침",
      "content": "自由を奪われた…馴染みのあるものにすり替えられた、\n見知らぬものに過ぎないだろう。"
    },
    {
      "id": 18,
      "model": "잔느변신2",
      "content": "…でも、私にとっては自由でしょうね。\n心地よく、安らかだわ。"
    },
    {
      "id": 19,
      "model": "잔느변신2",
      "content": "マ・ピュス。あなたは…私が間違っていると思う？"
    },
    {
      "id": 20,
      "model": "뫼르소다침",
      "content": "私は…正しいか間違っているかを判断するのが怖い。"
    },
    {
      "id": 21,
      "model": "잔느변신2",
      "content": "ただ、それだけ？"
    },
    {
      "id": 22,
      "model": "잔느변신2",
      "content": "ムルソー、私たちは飛べない。\n外では、あなたは真っ逆さまに落ちるわ。"
    },
    {
      "id": 23,
      "model": "뫼르소다침",
      "content": "あぁ。\n荷重を感じながら、私はゆっくり墜落していくだろう。"
    },
    {
      "id": 24,
      "model": "뫼르소다침",
      "content": "落ちながら、私は恐れとめまいを感じるだろう。"
    },
    {
      "id": 25,
      "model": "뫼르소다침",
      "content": "そして死ぬ日まで結局は…存在の明確な意味を、\n決して知ることはできないだろう。"
    },
    {
      "id": 26,
      "model": "뫼르소다침",
      "content": "私がどう流れていくか、何を選び何を諦めるべきかについての責任も、\n私にある。"
    },
    {
      "id": 27,
      "model": "뫼르소다침",
      "content": "だから私はあの声に従わない。\n君と…共には行かない。"
    },
    {
      "id": 28,
      "model": "잔느변신2",
      "content": "人々とぶつかりながら生き続けるというの？\nあの死にそうな痛みに、死ぬまで耐えながら？"
    },
    {
      "id": 29,
      "model": "뫼르소다침",
      "content": "あぁ。私たちの踊るワルツのように、君が理解したものと\n私が理解したものは違わざるを得ない。"
    },
    {
      "id": 30,
      "model": "뫼르소다침",
      "content": "だが、リズムを感じながらぶつかり続ける。\n直し続け、合わせ続けながら。"
    },
    {
      "id": 31,
      "model": "잔느변신2",
      "content": "何を直すべきかも分からないでしょう。\n一生合わせ続けても、滑稽な姿になるだけよ。"
    },
    {
      "id": 32,
      "model": "뫼르소다침",
      "content": "これからも分からないだろう。"
    },
    {
      "id": 33,
      "model": "뫼르소다침",
      "content": "だが、分からないからといって\n合わせていくのをやめはしない。"
    },
    {
      "id": 34,
      "model": "잔느변신2",
      "content": "…また、私から去っていくのね。"
    }
  ]
