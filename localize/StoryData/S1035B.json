{
  "dataList": [
    {
      "id": 0,
      "place": "5F レストラン",
      "model": "뷔페어른",
      "content": "…覚えては、いる。私をプイと呼んだ者たちを。"
    },
    {
      "id": 1,
      "model": "뷔페어른",
      "content": "その中でも、決して偽りを語らなかった者。\nムルソー。"
    },
    {
      "id": 2,
      "model": "뫼르소",
      "content": "……。"
    },
    {
      "id": 3,
      "model": "뷔페어른",
      "content": "私に従う者たちは\nみな私に望むばかりで、答えを出さなかった。"
    },
    {
      "id": 4,
      "model": "뷔페어른",
      "content": "でも…君は答えられるだろう。何を尋ねても、\n君はいつも知っていることを、ありのまま話してくれたから。"
    },
    {
      "id": 5,
      "model": "뷔페어른",
      "content": "ムルソー。なぜ私は…永遠に満たされない？\nこのレストランにあるものを、食べても食べても…。"
    },
    {
      "id": 6,
      "model": "뷔페어른",
      "content": "私は何一つ望まなかった。求めなかった。"
    },
    {
      "id": 7,
      "model": "뷔페어른",
      "content": "なのになぜ、私がこんな…酷い飢えを感じねばならないのか。"
    },
    {
      "id": 8,
      "model": "뫼르소",
      "content": "そのように生まれたからだ。"
    },
    {
      "id": 9,
      "model": "뷔페어른",
      "content": "そうか…。"
    },
    {
      "id": 10,
      "model": "뫼르소",
      "content": "だが、その事実を忘れるときがあった。"
    },
    {
      "id": 11,
      "model": "뫼르소",
      "content": "新しいことを知っていくとき。"
    },
    {
      "id": 12,
      "model": "뫼르소",
      "content": "うにょりと共にいるとき。"
    },
    {
      "id": 13,
      "model": "뫼르소",
      "content": "ゲームを、遊びをするとき。"
    },
    {
      "id": 14,
      "model": "뫼르소",
      "content": "お前はその苦痛を、しばし忘れた。"
    },
    {
      "id": 15,
      "model": "뷔페어른",
      "content": "……。"
    },
    {
      "id": 16,
      "model": "뷔페어른",
      "content": "そうだね、そうだった。"
    },
    {
      "id": 17,
      "model": "뷔페어른",
      "content": "そう言われると、君が抜かしていたものも一つ\n鮮明に思い出したな。"
    },
    {
      "id": 18,
      "model": "뷔페어른",
      "content": "君たちのあとについて歩き、\n時折振り返る君たちと目が合ったとき…。"
    },
    {
      "id": 19,
      "model": "뷔페어른",
      "content": "そのときは、少しも苦しくなかった。"
    },
    {
      "id": 20,
      "model": "뷔페어른",
      "content": "とても…楽しかった。飢えを忘れるほどに。"
    },
    {
      "id": 21,
      "content": "そしてビュッフェはしばらく攻撃をやめ、私たちを見つめた。"
    },
    {
      "id": 22,
      "model": "이상",
      "content": "プイ君。我らはそなたとの戦いを望まぬ。"
    },
    {
      "id": 23,
      "model": "뫼르소",
      "content": "…だが、戦うほかないだろう。"
    },
    {
      "id": 24,
      "model": "카르멘",
      "content": "<color=#E1B643>その通りよ、ムル。</color>"
    },
    {
      "id": 25,
      "model": "단테",
      "content": "<また、声が…。>"
    },
    {
      "id": 26,
      "model": "카르멘",
      "content": "<color=#E1B643>この世に勝手に生まれてしまったことが、\nどうしてあんなにも残酷なのか分かる？</color>"
    },
    {
      "id": 27,
      "model": "카르멘",
      "content": "<color=#E1B643>自分の意志で死ぬことさえ…怖がるように生まれたからよ。</color>"
    },
    {
      "id": 28,
      "model": "단테",
      "content": "<1階から感じていたけど、この声…だんだん近づいてる。>"
    },
    {
      "id": 29,
      "model": "이상",
      "content": "上るほどに…近づくということなりや？"
    },
    {
      "id": 30,
      "model": "뫼르소",
      "content": "……。"
    },
    {
      "id": 31,
      "model": "카르멘",
      "content": "<color=#E1B643>子どもを犠牲にしたという罪悪感。</color>"
    },
    {
      "id": 32,
      "model": "카르멘",
      "content": "<color=#E1B643>人類を治療したいという使命感。</color>"
    },
    {
      "id": 33,
      "model": "카르멘",
      "content": "<color=#E1B643>仲間を失望させたくないという責任感。</color>"
    },
    {
      "id": 34,
      "model": "카르멘",
      "content": "<color=#E1B643>…その全てが、死を前にして意味を失うの。</color>"
    },
    {
      "id": 35,
      "model": "카르멘",
      "content": "<color=#E1B643>あの子も同じでしょうね。</color>"
    },
    {
      "id": 36,
      "model": "카르멘",
      "content": "<color=#E1B643>あなたたちとの思い出、ル・ルージュから寄せられた期待、\n絶えず襲ってくる本能的な飢え。</color>"
    },
    {
      "id": 37,
      "model": "카르멘",
      "content": "<color=#E1B643>その全ての苦悩を抱えているから、\n今度は止まらないでしょうね。</color>"
    },
    {
      "id": 38,
      "model": "카르멘",
      "content": "<color=#E1B643>自分がいてこそ、全てがあることを…ビュッフェ、\nあの子も知っているでしょうから。</color>"
    },
    {
      "id": 39,
      "model": "뷔페어른",
      "content": "…今さら君たちについていったところで、\nこの飢えが消えるわけではない。"
    },
    {
      "id": 40,
      "model": "뷔페어른",
      "content": "ル・ルージュたちの願いや期待が暮れゆくこともないだろう。"
    },
    {
      "id": 41,
      "model": "뷔페어른",
      "content": "飢えを紛らわすためには…ここにある全てを食らわねばならない。\n君たちが上るべき場所さえ、食らわねばならない。"
    },
    {
      "id": 42,
      "model": "뷔페어른",
      "content": "いっそ…再びここに留まれ、異邦人たち。"
    },
    {
      "id": 43,
      "model": "단테",
      "content": "<…それはできない。>"
    },
    {
      "id": 44,
      "model": "단테",
      "content": "<だから私たちは…また、\n後悔する選択をしなければならないんだろうね。>"
    },
    {
      "id": 45,
      "model": "뫼르소",
      "content": "…私たちは上へ行く、ビュッフェ。"
    },
    {
      "id": 46,
      "model": "뷔페어른",
      "content": "結局、君たち異邦人は私に従わない存在なのだな。"
    }
  ]
