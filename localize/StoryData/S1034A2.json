{
  "dataList": [
    {
      "id": 0,
      "model": "뫼르소엄마",
      "teller": "母",
      "title": "巨人",
      "content": "あああああっ！"
    },
    {
      "id": 1,
      "model": "뫼르소",
      "content": "私の手には、母というものの生を止めたことで切れ落ちた、\n鎖の欠片一つが握られている。"
    },
    {
      "id": 2,
      "model": "뫼르소",
      "content": "これは象徴だ。"
    },
    {
      "id": 3,
      "model": "뫼르소",
      "content": "私を守り、私が立っていられるようにする象徴。"
    },
    {
      "id": 4,
      "model": "뫼르소",
      "content": "人々が勝手に私を視線に収めても、縛られたまま立っていられるように。"
    },
    {
      "id": 5,
      "model": "뫼르소",
      "content": "私を縛ったまま存在すれば…。"
    },
    {
      "id": 6,
      "model": "뫼르소",
      "content": "この世が恐ろしくとも、この世界に目が眩み\n吐き気がこみ上げようとも…。"
    },
    {
      "id": 7,
      "model": "뫼르소",
      "content": "耐えられる。"
    },
    {
      "id": 8,
      "model": "뫼르소",
      "content": "私はしばらく、静まり返った居間に座り\n窓の隙間から押し寄せる太陽光の中でぼんやりしていた。"
    },
    {
      "id": 9,
      "model": "뫼르소",
      "content": "空っぽになった場所。宙を漂う暖かな冷気。太陽。"
    },
    {
      "id": 10,
      "model": "뫼르소",
      "content": "そうして私は縛られ、止まった。"
    },
    {
      "id": 11,
      "place": "???",
      "model": "신부거인",
      "content": "縛られたまま、止まっていること…それがお前の守るべき業だった。"
    },
    {
      "id": 12,
      "model": "신부거인",
      "content": "今…お前が何をしようとしているか、分かっているのか？"
    },
    {
      "id": 13,
      "model": "신부거인",
      "content": "百貨店の定められた結末を外れれば、予測もつかず、\n手に負えないことが起こるだろう。その未来について考えたことはあるか？"
    },
    {
      "id": 14,
      "model": "뫼르소",
      "content": "分からない。だが、ここから出る。"
    },
    {
      "id": 15,
      "model": "신부거인",
      "content": "…無責任だな。"
    },
    {
      "id": 16,
      "model": "뫼르소",
      "content": "管理人様や他の者たちが\nこのまま閉じ込められることを、私は望まない。"
    },
    {
      "id": 17,
      "content": "司祭は次第に老い衰えていく。"
    },
    {
      "id": 18,
      "content": "ここで司祭が与えた永劫の時間が、\nそれに耐え続けることが、彼にとっても負担になりつつあるようだった。"
    },
    {
      "id": 19,
      "content": "時間には…耐える以外に答えがなかった。"
    },
    {
      "id": 20,
      "model": "신부거인",
      "content": "このままシーシュポス百貨店が崩壊すれば、ここにいる人間の姿をしていないものが、\n全て都市へ出ていくことになる。ここではマネキン、\n外ではねじれと呼ばれる怪物たちが、N社を荒らし回るだろう。"
    },
    {
      "id": 21,
      "model": "신부거인",
      "content": "この百貨店には…二つの結末しかあってはならない。"
    },
    {
      "id": 22,
      "model": "뫼르소",
      "content": "なぜそうでなければならない？"
    },
    {
      "id": 23,
      "model": "신부거인",
      "content": "人間は…欲望を抑えられる存在だからだ…。"
    },
    {
      "id": 24,
      "model": "신부거인",
      "content": "腹が空いたからといって人を食らわず、\n怒ったからといって家に火を放たない。"
    },
    {
      "id": 25,
      "model": "신부거인",
      "content": "獣は摂取し、人間は食事をする。欲望を抑え、食卓の前に座って食器を使うこと…\nそれこそが人間らしさだ。手づかみで食うのではなく！"
    },
    {
      "id": 26,
      "model": "신부거인",
      "content": "だから…このシーシュポスシステムこそが、\nこの都市で最も人間的な場所だ。"
    },
    {
      "id": 27,
      "model": "신부거인",
      "content": "野蛮が再び訪れれば…N社は他の翼と争い、戦争をするだろう。"
    },
    {
      "id": 28,
      "model": "신부거인",
      "content": "彼らは人の頭を開き、経験を掻き出そうとするだろう…\nそんな未来を望むのか？"
    },
    {
      "id": 29,
      "model": "신부거인",
      "content": "……。"
    },
    {
      "id": 30,
      "model": "신부거인",
      "content": "これ以上…罪人に力を注ぐわけにはいかないな。\n百貨店…このシーシュポスシステムが存続するために…\nここで退くべきだろう。"
    },
    {
      "id": 31,
      "model": "신부거인",
      "content": "やがて、この選択が間違いだったと悟ったときには、もう手遅れだ。\nそのとき後悔しても、全ては既に終わっているだろう…。"
    },
    {
      "id": 32,
      "model": "뫼르소",
      "content": "…あなたの言う通りだ。"
    },
    {
      "id": 33,
      "model": "뫼르소",
      "content": "いつか後悔するかもしれず、そのとき最善と思ったことが\nのちには最悪になることもあるだろう。\n私が決めたことは間違い得る。全ての意味は変わるものだから。"
    },
    {
      "id": 34,
      "model": "뫼르소",
      "content": "…だが。"
    },
    {
      "id": 35,
      "model": "뫼르소",
      "content": "引き受けてみたい。\n私が判断したことに対する、私の責任を。"
    },
    {
      "id": 36,
      "content": "ムルソーはまた、扉を開ける。"
    },
    {
      "id": 37,
      "model": "신부거인",
      "content": "百貨店は…保存されなければならない…\n百貨店は…維持されなければ…ならない…。"
    },
    {
      "id": 38,
      "model": "단테",
      "content": "<……。>"
    },
    {
      "id": 39,
      "model": "단테",
      "content": "<引き受けてみるって、本気？>"
    },
    {
      "id": 40,
      "model": "뫼르소",
      "content": "その通りです、管理人様。"
    },
    {
      "id": 41,
      "model": "단테",
      "content": "<どうしてそう思ったの？>"
    },
    {
      "id": 42,
      "model": "뫼르소",
      "content": "……。"
    },
    {
      "id": 43,
      "model": "뫼르소",
      "content": "理由については、まだよく分かりません。"
    },
    {
      "id": 44,
      "model": "뫼르소",
      "content": "しかし、理由は確かにここにありました。"
    }
  ]
