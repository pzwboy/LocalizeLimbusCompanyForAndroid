{
  "dataList": [
    {
      "id": 0,
      "place": "7F 明るい部屋",
      "content": "ジャンヌの言葉に、私と囚人たちは反論すべきことを見つけられなかった。"
    },
    {
      "id": 1,
      "content": "一連の過程と、一連の感情を、偽りなく聞いたのに…。"
    },
    {
      "id": 2,
      "content": "彼らが語る見知らぬ世界、\nそのものが馴染みのないものに感じられた。"
    },
    {
      "id": 3,
      "model": "잔느변신",
      "content": "赤を見て、赤いと言う人々。"
    },
    {
      "id": 4,
      "model": "잔느변신",
      "content": "でも、その人たちが見ている色は、\n本当に私が見ている色と同じなのかしら？"
    },
    {
      "id": 5,
      "model": "잔느변신",
      "content": "それは誰にも分からないでしょう、マ・ピュス。"
    },
    {
      "id": 6,
      "model": "잔느변신",
      "content": "人々は皆、同じ言葉を使い、同じものを見ていると\n思い込むけれど…本当はそうじゃない。"
    },
    {
      "id": 7,
      "model": "잔느변신",
      "content": "でも…この百貨店は違う。\n私の見る赤を、私が作った赤を顧客はそのまま感じる。"
    },
    {
      "id": 8,
      "model": "잔느변신",
      "content": "私が作るワルツを、顧客たちは寸分違わず\nそのまま踊るわ。"
    },
    {
      "id": 9,
      "model": "잔느변신",
      "content": "右足。"
    },
    {
      "id": 10,
      "model": "잔느변신",
      "content": "左足。"
    },
    {
      "id": 11,
      "model": "잔느변신",
      "content": "また右足！"
    },
    {
      "id": 12,
      "model": "잔느변신",
      "content": "私が動く通りについていき、\nあなたが動く通りについてくる！"
    },
    {
      "id": 13,
      "model": "잔느변신",
      "content": "私を見て、ムルソー。"
    },
    {
      "id": 14,
      "model": "단테",
      "content": "<…！>"
    },
    {
      "id": 15
    },
    {
      "id": 16,
      "content": "舞台のような空間が広がったあと…。"
    },
    {
      "id": 17,
      "content": "私と囚人たちを照らしていた光が、全てふっと消えた。"
    },
    {
      "id": 18
    },
    {
      "id": 19,
      "content": "空から差す光は、ジャンヌとムルソーの二人だけを照らしていた。"
    },
    {
      "id": 20,
      "model": "잔느변신2",
      "content": "泉から来た異邦人たちが\nあなたに釘刺した役柄なんて、気にする必要はないわ。"
    },
    {
      "id": 21,
      "model": "잔느변신2",
      "content": "分かっているでしょう、マ・ピュス。\nあの人たちは異邦人って呼ばれていたけれど、本当は異邦人じゃないことを。"
    },
    {
      "id": 22,
      "model": "카르멘",
      "content": "<color=#E1B643>感情の落差を生み出す罪悪感には…\nううん。全ての落差には結局、善と悪が必要なの。</color>"
    },
    {
      "id": 23,
      "model": "잔느변신2",
      "content": "この舞台の異邦人は…私たち二人だけよ。"
    },
    {
      "id": 24,
      "model": "카르멘",
      "content": "<color=#E1B643>だから考えに考えて、自分だけの価値観を生み出し…。</color>"
    },
    {
      "id": 25,
      "model": "카르멘",
      "content": "<color=#E1B643>自分が生み出した価値観で、善と悪を分けられるなら。</color>"
    },
    {
      "id": 26,
      "model": "카르멘",
      "content": "<color=#E1B643>そうして分かれた善と悪から\n感情の落差を認識し、感じられるなら。</color>"
    },
    {
      "id": 27,
      "model": "잔느변신2",
      "content": "マ・ピュス。あなたは私が何を好きで、何を嫌いか知っている。"
    },
    {
      "id": 28,
      "model": "카르멘",
      "content": "<color=#E1B643>自分が何を肯定し、否定するのか、</color>"
    },
    {
      "id": 29,
      "model": "카르멘",
      "content": "<color=#E1B643>自分が何を喜び、苦しむのかを知る人なら。</color>"
    },
    {
      "id": 30,
      "model": "잔느변신2",
      "content": "私の喜ぶものと、私の苦しむものを理解している。"
    },
    {
      "id": 31,
      "model": "카르멘",
      "content": "<color=#E1B643>自分になれる。</color>"
    },
    {
      "id": 32,
      "model": "잔느변신2",
      "content": "だから…。"
    },
    {
      "id": 33,
      "model": "잔느변신2",
      "content": "私は、あなたに外へ出てほしくない。"
    },
    {
      "id": 34,
      "model": "잔느변신2",
      "content": "私たちの目の前にはっきりとある陽射しに…\n身を委ねちゃいけないの？"
    },
    {
      "id": 35,
      "model": "뫼르소",
      "content": "…それはできない。"
    },
    {
      "id": 36,
      "model": "뫼르소",
      "content": "囚人たちには、管理人様には…\nここを出なければならない目的がある。"
    },
    {
      "id": 37,
      "model": "잔느변신2",
      "content": "でも、あなたにはないでしょう。"
    },
    {
      "id": 38,
      "model": "잔느변신2",
      "content": "何が足りないの？もっと強烈な音楽？もっと華やかな舞台？"
    },
    {
      "id": 39,
      "model": "뫼르소",
      "content": "…何かが足りないと思ったことはない。"
    },
    {
      "id": 40,
      "model": "잔느변신2",
      "content": "マ・ピュス。\nあなたはまだ、本当の踊りを知らないのよ。"
    },
    {
      "id": 41,
      "model": "잔느변신2",
      "content": "私の傍に来て。\n手取り足取り…教えてあげるから。"
    },
    {}
  ]
}
