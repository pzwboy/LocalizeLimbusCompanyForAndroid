{
    "dataList": [
        {
            "id": 0,
            "place": "7F 明室",
            "content": "面対譲娜的話語，我和罪人們都找不到方法去反駁他。"
        },
        {
            "id": 1,
            "content": "即使真真切切地听到了那一連串的過程与情感……"
        },
        {
            "id": 2,
            "content": "我対他們所説的那未知世界本身便感到陌生。"
        },
        {
            "id": 3,
            "model": "잔느변신",
            "content": "看到紅色后，人們会将其説成是紅色。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 4,
            "model": "잔느변신",
            "content": "但那些人看到的顔色，真的和我看到的顔色一様麼？",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 5,
            "model": "잔느변신",
            "content": "誰也无法確定叭，小可愛。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 6,
            "model": "잔느변신",
            "content": "雖然人人都以為彼此使用着相同的語言，看着相同的事物……實際上却并非如此。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 7,
            "model": "잔느변신",
            "content": "但……這家百貨店不同。顧客能原原本本地感受到我所見，所制作的紅色。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 8,
            "model": "잔느변신",
            "content": "顧客們会分毫不差地跳出我所制作的華尓茲。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 9,
            "model": "잔느변신",
            "content": "右脚。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 10,
            "model": "잔느변신",
            "content": "左脚。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 11,
            "model": "잔느변신",
            "content": "再踏出右脚！",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 12,
            "model": "잔느변신",
            "content": "跟随我的每一个動作，袮的每一个動作！",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 13,
            "model": "잔느변신",
            "content": "看着我，默尓索。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 14,
            "model": "단테",
            "content": "<……！>",
            "teller": "但丁",
            "title": "執行經理"
        },
        {
            "id": 15
        },
        {
            "id": 16,
            "content": "随着舞台一様的空間拡展開来……"
        },
        {
            "id": 17,
            "content": "照向我和罪人們的光忽然尽数熄滅。"
        },
        {
            "id": 18
        },
        {
            "id": 19,
            "content": "从上方射下的光只照向譲娜和默尓索兩人。"
        },
        {
            "id": 20,
            "model": "잔느변신2",
            "content": "不必去在意那些来自泉的異郷人們為袮釘下的角色。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 21,
            "model": "잔느변신2",
            "content": "袮知道的，小可愛。雖然那些人被称作異郷人，實際上却并不是<ruby=局外人>異郷人</ruby>。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 22,
            "model": "카르멘",
            "content": "<color=#E1B643>造成情感落差的負罪感……不対。一切落差説到底都需要善与惡。</color>",
            "teller": "？？？",
            "title": "？？？"
        },
        {
            "id": 23,
            "model": "잔느변신2",
            "content": "這舞台上的<ruby=局外人>異郷人</ruby>……只有袮和我。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 24,
            "model": "카르멘",
            "content": "<color=#E1B643>所以去思考又思考，創造出独属于自己的价値観……</color>",
            "teller": "？？？",
            "title": "？？？"
        },
        {
            "id": 25,
            "model": "카르멘",
            "content": "<color=#E1B643>如果自己創造出的价値観能劬将善惡劃分。</color>",
            "teller": "？？？",
            "title": "？？？"
        },
        {
            "id": 26,
            "model": "카르멘",
            "content": "<color=#E1B643>如果能在那様被劃分出的善惡中意識并感受到情感的落差。</color>",
            "teller": "？？？",
            "title": "？？？"
        },
        {
            "id": 27,
            "model": "잔느변신2",
            "content": "小可愛。袮知道我喜歓什么，討厭什么。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 28,
            "model": "카르멘",
            "content": "<color=#E1B643>如果我能清楚自己能肯定什么、会否定什么，</color>",
            "teller": "？？？",
            "title": "？？？"
        },
        {
            "id": 29,
            "model": "카르멘",
            "content": "<color=#E1B643>清楚自己会因何而欣喜，為何而痛苦。</color>",
            "teller": "？？？",
            "title": "？？？"
        },
        {
            "id": 30,
            "model": "잔느변신2",
            "content": "袮理解我的欣喜，我的痛苦。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 31,
            "model": "카르멘",
            "content": "<color=#E1B643>“我”便能成為“自己”。</color>",
            "teller": "？？？",
            "title": "？？？"
        },
        {
            "id": 32,
            "model": "잔느변신2",
            "content": "所以……",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 33,
            "model": "잔느변신2",
            "content": "我不想譲袮出去。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 34,
            "model": "잔느변신2",
            "content": "我們為什么不委身于……眼前這清晰可見的陽光捏？",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 35,
            "model": "뫼르소",
            "content": "……那不可能。",
            "teller": "默尓索",
            "title": "5号罪人"
        },
        {
            "id": 36,
            "model": "뫼르소",
            "content": "罪人們和執行經理……有必須离開這里的目的。",
            "teller": "默尓索",
            "title": "5号罪人"
        },
        {
            "id": 37,
            "model": "잔느변신2",
            "content": "可袮没有。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 38,
            "model": "잔느변신2",
            "content": "缺了什么？更強烈的音樂？更華麗的舞台？",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 39,
            "model": "뫼르소",
            "content": "……我从未想過自己缺少什么。",
            "teller": "默尓索",
            "title": "5号罪人"
        },
        {
            "id": 40,
            "model": "잔느변신2",
            "content": "小可愛。袮還不知道真正的舞蹈是什么様捏。",
            "teller": "譲娜",
            "title": "巨人"
        },
        {
            "id": 41,
            "model": "잔느변신2",
            "content": "来我身辺。我会手把手地……教給袮。",
            "teller": "譲娜",
