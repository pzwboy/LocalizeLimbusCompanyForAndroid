{
    "dataList": [
        {
            "id": 0,
            "content": "百貨店必須持續消費。"
        },
        {
            "id": 1,
            "content": "人人都源源不断地進食。"
        },
        {
            "id": 2,
            "content": "有人期盼這瞬間永不終結。"
        },
        {
            "id": 3,
            "content": "期盼這逐漸充實的満足感永不終結。"
        },
        {
            "id": 4,
            "content": "百貨店内的大家如今如同脱疆一般，只顧着消費。"
        },
        {
            "id": 5,
            "content": "再也无人創造。"
        },
        {
            "id": 6,
            "content": "只是進食，裹身，排泄，消費而已。"
        },
        {
            "id": 7,
            "content": "一開始只是進食黑派或褐派那些所属不同的人。"
        },
        {
            "id": 8,
            "content": "可一旦其他食物被呑噬一空，最終会演変成互相肯食叭。"
        },
        {
            "id": 9,
            "content": "這分慣性已經无法停止了。"
        },
        {
            "id": 10,
            "content": "会如此互相呑食，直到剩下唯一一个。"
        },
        {
            "id": 11,
            "content": "最后應該只有自助餐会留下叭。身辺空无一人。"
        },
        {
            "id": 12,
            "content": "這些人所追求的經驗并不只是充足地活在当下。"
        },
        {
            "id": 13,
            "content": "曾經感受過的味道、飽腹感。快感。"
        },
        {
            "id": 14,
            "content": "為了再次感受那些，才会想要經驗。"
        },
        {
            "id": 15,
            "content": "填満后又変得空蕩，于是再次填満。"
        },
        {
            "id": 16,
            "content": "人本就被如此創造，總会不断渴望某物。"
        },
        {
            "id": 17,
            "content": "不覚得很残酷麼？"
        },
        {
            "id": 18,
            "content": "這様不知満足的命運。"
        },
        {
            "id": 19,
            "content": "所以黑派才会選擇停止。記得麼？"
        },
        {
            "id": 20,
            "content": "因為一切都顕得可怖啊。"
        },
        {
            "id": 21,
            "content": "因為害怕死亡，所以才将自己固定在死亡来臨前的記憶。"
        },
        {
            "id": 22,
            "content": "因為害怕死亡，為了忘記死亡去用其他經驗填充，从而放弃自我。"
        },
        {
            "id": 23,
            "content": "作為逃避死亡的方法，雖然過程有所不同，但那結果却又近乎一致。"
        },
        {
            "id": 24,
            "content": "可相似到極点的事物……"
        },
        {
            "id": 25,
            "content": "<只要身為人類就无法区分，対叭。>"
        },
        {
            "id": 26,
            "content": "在百貨店外也是一様。"
        },
        {
            "id": 27,
            "content": "不過是過程与形式看似不同而已。"
        },
        {
            "id": 28,
            "content": "大家都害怕死亡，因此都以自己的方式爭扎着。"
        },
        {
            "id": 29,
            "content": "一旦誕生，那死亡必然在尽頭等待。"
        },
        {
            "id": 30,
            "content": "而抵達死亡的過程中，人類注定不知満足。只是，生而如此罷了。"
        },
        {
            "id": 31,
            "content": "袮覚得為什么人們被如此創造捏？会不会有什么理由？"
        },
        {
            "id": 32,
            "content": "不過，我并不想対人類的存在理由或根源，或是設計之類的做些什么。"
        },
        {
            "id": 33,
            "content": "始于誕生，步向死亡的道路……只希望至少在那路上，自己能劬成為“自己”。"
        },
        {
            "id": 34,
            "content": "那么，雖然喂飽空腹的孩子不能算是罪孼……"
        },
        {
            "id": 35,
            "content": "但那孩子應該不会留下任何東西叭。"
        },
        {
            "id": 36,
            "content": "黄金会被剥至最后一根，"
        },
        {
            "id": 37,
            "content": "百貨店如同被削去血肉一様……日漸消瘦，逐漸枯竭。"
        },
        {
            "id": 38,
            "content": "雖然或許永遠无法飽腹，但……"
        },
        {
            "id": 39,
            "content": "祝用餐愉快。"
        }
    ]
}