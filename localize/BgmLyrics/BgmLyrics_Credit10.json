{
  "dataList": [
    {
      "id": "0",
      "content": "<color=#293B95>影を追っていた日々</color>"
    },
    {
      "id": "1",
      "content": "<color=#293B95>残るは虚しい記憶</color>"
    },
    {
      "id": "2",
      "content": "<color=#293B95>火の手が私を焦がしたように</color>"
    },
    {
      "id": "3",
      "content": "<color=#293B95>私の手に残るは灰色の埃</color>"
    },
    {
      "id": "4",
      "content": "<color=#293B95>休むことなく駆けてきた</color>"
    },
    {
      "id": "5",
      "content": "<color=#293B95>私を締め付けてきた時間</color>"
    },
    {
      "id": "6",
      "content": "<color=#293B95>それすら愛おしくなるか</color>"
    },
    {
      "id": "7",
      "content": "<color=#293B95>遠い日のいつかは</color>"
    },
    {
      "id": "8",
      "content": "<color=#293B95>振り返る記憶の中に</color>"
    },
    {
      "id": "9",
      "content": "<color=#293B95>笑みを浮かべられますように</color>"
    },
    {
      "id": "10",
      "content": "<color=#293B95>私に残った計り知れぬ時間と</color>"
    },
    {
      "id": "11",
      "content": "<color=#293B95>いまや進むべき時</color>"
    },
    {
      "id": "12",
      "content": "<color=#293B95>自らを燃やし消えゆく</color>"
    },
    {
      "id": "13",
      "content": "<color=#293B95>蝋燭のようだ</color>"
    },
    {
      "id": "14",
      "content": "<color=#293B95>息を整える間もなく</color>"
    },
    {
      "id": "15",
      "content": "<color=#293B95>押し流され放り捨てられた日の中で</color>"
    },
    {
      "id": "16",
      "content": "<color=#293B95>私の道を征けますように</color>"
    },
    {
      "id": "17",
      "content": "<color=#293B95>遠い日のいつかは</color>"
    },
    {
      "id": "18",
      "content": "<color=#293B95>振り返る記憶の中に</color>"
    },
    {
      "id": "19",
      "content": "<color=#293B95>笑みを浮かべられるように</color>"
    },
    {
      "id": "20",
      "content": "<color=#293B95>遠く遠く飛んでいきたい</color>"
    },
    {
      "id": "21",
      "content": "<color=#293B95>夜空の鳥のごとく星へと至れるように</color>"
    },
    {
      "id": "22",
      "content": "<color=#293B95>今夜、また今夜と訪れて来るだろうけど</color>"
    },
    {
      "id": "23",
      "content": "<color=#293B95>大丈夫、みんな生きてる</color>"
    },
    {
      "id": "24",
      "content": "<color=#293B95>大丈夫</color>"
    }
  ]
}
