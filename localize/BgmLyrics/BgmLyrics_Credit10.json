{
    "dataList": [
        {
            "id": "0",
            "content": "<color=#293B95>追逐虚影的旧時光</color>"
        },
        {
            "id": "1",
            "content": "<color=#293B95>只剩下空洞的回憶</color>"
        },
        {
            "id": "2",
            "content": "<color=#293B95>就像火焰灼焼了我</color>"
        },
        {
            "id": "3",
            "content": "<color=#293B95>我的手中只剩下灰燼</color>"
        },
        {
            "id": "4",
            "content": "<color=#293B95>我奔砲着，毫不停歇</color>"
        },
        {
            "id": "5",
            "content": "<color=#293B95>那些曾譲我感到窒息的時光</color>"
        },
        {
            "id": "6",
            "content": "<color=#293B95>到頭来也会譲我覚得珍貴麼</color>"
        },
        {
            "id": "7",
            "content": "<color=#293B95>在遥遠未来的某天</color>"
        },
        {
            "id": "8",
            "content": "<color=#293B95>当我回顧那些記憶時</color>"
        },
        {
            "id": "9",
            "content": "<color=#293B95>我真希望自己能劬微笑</color>"
        },
        {
            "id": "10",
            "content": "<color=#293B95>不論現在還剩下多少時間</color>"
        },
        {
            "id": "11",
            "content": "<color=#293B95>我都該向前邁步了</color>"
        },
        {
            "id": "12",
            "content": "<color=#293B95>将自己燃焼殆尽</color>"
        },
        {
            "id": "13",
            "content": "<color=#293B95>就像蝋蝕那様</color>"
        },
        {
            "id": "14",
            "content": "<color=#293B95>没有喘息的空閑</color>"
        },
        {
            "id": "15",
            "content": "<color=#293B95>我被卷入這動蕩的日子里</color>"
        },
        {
            "id": "16",
            "content": "<color=#293B95>希望我能劬開拓自己的路</color>"
        },
        {
            "id": "17",
            "content": "<color=#293B95>在遥遠未来的某天</color>"
        },
        {
            "id": "18",
            "content": "<color=#293B95>当我回顧那些記憶時</color>"
        },
        {
            "id": "19",
            "content": "<color=#293B95>我真希望自己能劬微笑</color>"
        },
        {
            "id": "20",
            "content": "<color=#293B95>譲我，譲我飛得如此之遠</color>"
        },
        {
            "id": "21",
            "content": "<color=#293B95>像夜空中的鳥儿一般触摸星辰</color>"
        },
        {
            "id": "22",
            "content": "<color=#293B95>這夜，這夜晚一定還会到来</color>"
        },
        {
            "id": "23",
            "content": "<color=#293B95>但没関系，我会活下去</color>"
        },
        {
            "id": "24",
            "content": "<color=#293B95>会没事的</color>"
        }
    ]
}