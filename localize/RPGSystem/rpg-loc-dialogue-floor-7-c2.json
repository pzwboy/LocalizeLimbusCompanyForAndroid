        {
            "key": "D7003_C2",
            "texts": [
                {
                    "index": 0,
                    "text": "坐叭，小可愛。",
                    "speaker": "譲娜"
                },
                {
                    "index": 1,
                    "text": "進入這里后袮還一次也没坐下過叭？",
                    "speaker": "譲娜"
