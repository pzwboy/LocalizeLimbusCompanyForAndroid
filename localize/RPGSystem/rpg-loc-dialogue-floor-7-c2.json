    {
      "key": "D7003_C2",
      "texts": [
        {
          "index": 0,
          "text": "椅子に座って、マ・ピュス。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 1,
          "text": "今まで一度も座れなかったでしょう？",
          "speaker": "ジャンヌ"
        }
      ]
    },
    {
      "key": "D7006_C2",
      "texts": [
        {
