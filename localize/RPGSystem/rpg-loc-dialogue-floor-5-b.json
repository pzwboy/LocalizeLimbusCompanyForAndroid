{
  "dataList": [
    {
      "key": "D50011",
      "texts": [
        {
          "index": 0,
          "text": "はぁ。来るには来たけど…。\nここ、入れるのかすら分からんな。",
          "speaker": "グレゴール"
        },
        {
          "index": 1,
          "text": "入口は尋常ならざるものにて塞がれたり…\n物理的な手段にて破り得るとは見えぬ…。",
          "speaker": "イサン"
        },
        {
          "index": 2,
          "text": "……。",
          "speaker": "プイ"
        }
      ]
    },
    {
      "key": "D50012",
      "texts": [
        {
          "index": 0,
          "text": "プイが無言で5階の入り口に手を触れ、\nしばらくじっとしてから…。"
        }
      ]
    },
    {
      "key": "D50012A",
      "texts": [
        {
          "index": 0,
          "text": "やがて、首を振って手を下ろした。"
        }
      ]
    },
    {
      "key": "D50013",
      "texts": [
        {
          "index": 0,
          "text": "…入れない。わたしも、あなたたちも。",
          "speaker": "プイ"
        },
        {
          "index": 1,
          "text": "まだ…美徳が足りない…。",
          "speaker": "プイ"
        },
        {
          "index": 2,
          "text": "<美徳…？>",
          "speaker": "ダンテ"
        }
      ]
    },
    {
      "key": "D50014",
      "texts": [
        {
          "index": 0,
          "text": "そう、あのちびっ子は美徳が全然足りないから…\nこんな格式ある空間には、まだふさわしくないんだ。",
          "speaker": "クローマー"
        }
      ]
    },
    {
      "key": "D50015",
      "texts": [
        {
          "index": 0,
          "text": "クローマー…！",
          "speaker": "イサン"
        }
      ]
    },
    {
      "key": "D5901",
      "texts": [
        {
          "index": 0,
          "text": "ル・ノワールに属していた者の死体だ。\n血にぐっしょり濡れた服が、徐々にどす黒い赤へと変わっていく。"
        }
      ]
    },
    {
      "key": "D5902",
      "texts": [
        {
          "index": 0,
          "text": "ル・ルージュに属していた者の死体だ。大きく膨らませた服が、\n血を吸って、ぐったりと垂れている。"
        }
      ]
    },
    {
      "key": "D5006",
      "texts": [
        {
          "index": 0,
          "text": "帳に触れると、表面がさざ波のように揺れた。"
        }
      ]
    },
    {
      "key": "D5002",
      "texts": [
        {
          "index": 0,
          "text": "そのとき、プイが一行を押しのけて前に出た。"
        }
      ]
    },
    {
      "key": "D5002A",
      "texts": [
        {
          "index": 0,
          "text": "小さな手が、帳へ伸びる。"
        }
      ]
    },
    {
      "key": "D5002B",
      "texts": [
        {
          "index": 0,
          "text": "帳が揺らめく。これなら中に入れそうだ。"
        },
        {
          "index": 1,
          "text": "<今なら、帳の向こうへ入れそうだ。>",
          "speaker": "ダンテ"
        }
      ]
    },
    {
      "key": "D5008",
      "texts": [
        {
          "index": 0,
          "text": "わたし…あくびが出る。",
          "speaker": "プイ"
        },
        {
          "index": 1,
          "text": "眠い…目が、すごく重くて…。",
          "speaker": "プイ"
        },
        {
          "index": 2,
          "text": "また…眠れそう。",
          "speaker": "プイ"
        },
        {
          "index": 3,
          "text": "つらき戦いなりき。\n暫し眠る程度は、構わぬのではないか。",
          "speaker": "イサン"
        },
        {
          "index": 4,
          "text": "少し…じゃないかもしれない…。",
          "speaker": "プイ"
        },
        {
          "index": 5,
          "text": "それでも構わぬ。",
          "speaker": "イサン"
        },
        {
          "index": 6,
          "text": "<そうだよ…私たちも、少し休んだ方がよさそうだし…。>",
          "speaker": "ダンテ"
        },
        {
          "index": 7,
          "text": "……。",
          "speaker": "プイ"
        },
        {
          "index": 8,
          "text": "わたしが目を覚ましたとき…。",
          "speaker": "プイ"
        },
        {
          "index": 9,
          "text": "あなたたちが、そばにいてほしい。",
          "speaker": "プイ"
        },
        {
          "index": 10,
          "text": "前もそうだったように。今回もそうだったように。",
          "speaker": "プイ"
        },
        {
          "index": 11,
          "text": "…そうしよう。",
          "speaker": "ムルソー"
        },
        {
          "index": 12,
          "text": "安心して眠れ。",
          "speaker": "ムルソー"
        }
      ]
    },
    {
      "key": "D5008A",
      "texts": [
        {
          "index": 0,
          "text": "…うん。",
          "speaker": "プイ"
        },
        {
          "index": 1,
          "text": "良き夢を見たまえ、プイ君。",
          "speaker": "イサン"
        }
      ]
    },
    {
      "key": "D5013",
      "texts": [
        {
          "index": 0,
          "text": "すぐにすやすやと寝息が聞こえ、プイの周りの\n赤いひだが無秩序に絡み合い始めた。"
        }
      ]
    },
    {
      "key": "D5013A",
      "texts": [
        {
          "index": 0,
          "text": "そして、最初に見た繭のように…赤い膜が、子供を包んだ。"
        }
      ]
    },
    {
      "key": "D5013B",
      "texts": [
        {
          "index": 0,
          "text": "繭になったぞ…？",
          "speaker": "グレゴール"
        },
        {
          "index": 1,
          "text": "時折…成体となるため、姿を変ずる生き物もありき。\n故郷にてよく見し蝶が、さようなりき。",
          "speaker": "イサン"
        },
        {
          "index": 2,
          "text": "蛹…みたいなものか。",
          "speaker": "グレゴール"
        },
        {
          "index": 3,
          "text": "昔の何かを思い浮かべたのか、グレゴールの顔が、\n一瞬強張ったけど…。"
        },
        {
          "index": 4,
          "text": "すぐに首を振り、いつもの様子へ戻った。"
        },
        {
          "index": 5,
          "text": "いやぁ…こりゃ本格的に、\n保護者役をきっちり果たすことになるな。",
          "speaker": "グレゴール"
        },
        {
          "index": 6,
          "text": "目覚むるまで誰かが守りてやらねば…難儀ならん。",
          "speaker": "イサン"
        },
        {
          "index": 7,
          "text": "まあ、おかげで5階まで来られたのも確かだからな。\n知らん顔するのも、気が引けるし。",
          "speaker": "グレゴール"
        }
      ]
    },
    {
      "key": "D5013C",
      "texts": [
        {
          "index": 0,
          "text": "やがて繭からいくつもの口が現れ\n食卓に置かれた食べ物を、がつがつと食べ始めた。"
        }
      ]
    },
    {
      "key": "D5013D",
      "texts": [
        {
          "index": 0,
          "text": "中で飢えを…満たしているように見えます。",
          "speaker": "ムルソー"
        },
        {
          "index": 1,
          "text": "<…もうすぐル・ノワールたちが押し寄せてくるよ。>",
          "speaker": "ダンテ"
        }
      ]
    },
    {
      "key": "D5003",
      "texts": [
        {
          "index": 0,
          "text": "<color=#7d7d7d>泉の異邦人が、血と肉から成る者を、歌の中へ迎え入れた。\nこれぞ枯渇の証人である。</color>"
        },
        {
          "index": 1,
          "text": "<color=#7d7d7d>我を信仰する子よ。誕生の果ては死である。\n金鎚を振り下ろし、死をもって誕生を阻め。さすれば初めて、\n汝もシーシュポスの名の下に、永遠となるであろう。</color>"
        }
      ]
    },
    {
      "key": "D5003A",
      "texts": [
        {
          "index": 0,
          "text": "声は仰せになる。それは貪欲にして過欲、\n飢えにして渇きである。\n再誕の果てには、何一つ残るまいと。",
          "speaker": "ル・ノワール ブランドマネージャー"
        },
        {
          "index": 1,
          "text": "金鎚を振り上げた者がゆっくりと私たちへ、\nプイの繭へと近づいてくる。"
        }
      ]
    },
    {
      "key": "D5003B",
      "texts": [
        {
          "index": 0,
          "text": "よりによって、こんなときに…出くわしちまったな。",
          "speaker": "グレゴール"
        },
        {
          "index": 1,
          "text": "聞こえ来るこの声……されば、プイ君が\n眠りに落ちし折を狙いたるようにも思えり。",
          "speaker": "イサン"
        }
      ]
    },
    {
      "key": "D5007",
      "texts": [
        {
          "index": 0,
          "text": "…終わりたるや。",
          "speaker": "イサン"
        },
        {
          "index": 1,
          "text": "やれやれ…一日中戦ってると、身体がくたびれるな。\nあるいはシミュレーションの世界らしいから、\n精神がくたびれるって言うべきか？",
          "speaker": "グレゴール"
        },
        {
          "index": 2,
          "text": "<…もう、ここまで来るル・ノワールはいなさそうだ。>",
          "speaker": "ダンテ"
        },
        {
          "index": 3,
          "text": "<プイは…？>",
          "speaker": "ダンテ"
        },
        {
          "index": 4,
          "text": "無事です。それから…間もなく目覚めそうです。",
          "speaker": "ムルソー"
        }
      ]
    },
    {
      "key": "D5010",
      "texts": [
        {
          "index": 0,
          "text": "幾重にも垂れた赤いひだが、膨らんでは萎むこと数十回…。"
        }
      ]
    },
    {
      "key": "D5011",
      "texts": [
        {
          "index": 0,
          "text": "いやぁ…服装ひとつで見違えるもんだな、うん。\nじゃあ、これでレストランに入れるのか？",
          "speaker": "グレゴール"
        },
        {
          "index": 1,
          "text": "…うん。",
          "speaker": "プイ"
        },
        {
          "index": 2,
          "text": "ふむ…声に力なく、肩もがっくりと落ちたるように\n見ゆれど…未だ、うにょりのことを思いたりや？",
          "speaker": "イサン"
        },
        {
          "index": 3,
          "text": "……。",
          "speaker": "プイ"
        },
        {
          "index": 4,
          "text": "うにょり？ああ…あの、キーッて鳴きながら、\nムルソーさんの肩の上をふわふわ飛んでた、アレ？",
          "speaker": "グレゴール"
        },
        {
          "index": 5,
          "text": "下の階で、何があったんだか…。",
          "speaker": "グレゴール"
        },
        {
          "index": 6,
          "text": "<大切にしてたうにょりを…プイが食べちゃったんだ。>",
          "speaker": "ダンテ"
        },
        {
          "index": 7,
          "text": "た、食べたのか？はっ…ここじゃ常識が違うんだし、\nそういうこともあるのか？\nそれでも、結構大事にしてた気がするんだけどな。",
          "speaker": "グレゴール"
        }
      ]
    },
    {
      "key": "D5017",
      "texts": [
        {
          "index": 0,
          "text": "…後方より、何やら強き振動…そして鳴き声が感ぜらる。",
          "speaker": "イサン"
        },
        {
          "index": 1,
          "text": "この震えは…。",
          "speaker": "ムルソー"
        },
        {
          "index": 2,
          "text": "古き存在と呼んでいたものが…間もなく到着しそうです。",
          "speaker": "ムルソー"
        },
        {
          "index": 3,
          "text": "いつ…来るの…。",
          "speaker": "プイ"
        },
        {
          "index": 4,
          "text": "約3秒後に到着する。",
          "speaker": "ムルソー"
        },
        {
          "index": 5,
          "text": "……。",
          "speaker": "プイ"
        }
      ]
    },
    {
      "key": "D5018",
      "texts": [
        {
          "index": 0,
          "text": "グオオオオオ！！！！！",
          "speaker": "黒い糸"
        }
      ]
    },
    {
      "key": "D5019",
      "texts": [
        {
          "index": 0,
          "text": "後ろから追ってくる古き存在から\n先に始末する必要があるかと思います、管理人様。",
          "speaker": "ムルソー"
        }
      ]
    },
    {
      "key": "D5020",
      "texts": [
        {
          "index": 0,
          "text": "<color=#7d7d7d>視線を恐れぬ、不届きなる裸の者どもが…\n貪欲なる災厄を紡ぎ上げた。我が子らよ、我が権能をもって、\n汝らに、待たずして階を上ることを許そう。</color>"
        }
      ]
    },
    {
      "key": "D5021",
      "texts": [
        {
          "index": 0,
          "text": "待てよ、今の放送…内容が、すごく不穏じゃなかったか？",
          "speaker": "グレゴール"
        },
        {
          "index": 1,
          "text": "…どうやら、直ちに戦闘の準備をせねばならぬようなり。",
          "speaker": "イサン"
        }
      ]
    },
    {
      "key": "D5022",
      "texts": [
        {
          "index": 0,
          "text": "あそこだ！あそこに、異邦人どもが…！",
          "speaker": "ル・ノワールの警備員"
        },
        {
          "index": 1,
          "text": "<ムルソー。止まらず、進み続けないと。>",
          "speaker": "ダンテ"
        },
        {
          "index": 2,
          "text": "…はい。承知しました。",
          "speaker": "ムルソー"
        }
      ]
    },
    {
      "key": "D-PB-BLACKTHREAD",
      "texts": [
        {
          "index": 0,
          "text": "黒い糸の間から、果てしない悲しみがにじみ出る。"
        },
        {
          "index": 1,
          "text": "黒い波が足首に絡みつき、襲いかかってくる。"
        }
      ]
    },
    {
      "key": "D5004",
      "texts": [
        {
          "index": 0,
          "text": "<ここまで上れば…もう追ってこられないだろう。>",
          "speaker": "ダンテ"
        },
        {
          "index": 1,
          "text": "ティブルの上…のようなり。\n綺麗に整えられし食事の最中に、失礼せしやも…。",
          "speaker": "イサン"
        },
        {
          "index": 2,
          "text": "そんなこと言ってる状況じゃなかっただろ。\nでも、これで少しは休め―",
          "speaker": "グレゴール"
        },
        {
          "index": 3,
          "text": "<color=#7d7d7d>高貴ならざる我が子らよ。歩みの一つ一つに釘刺せと命ずる。\n渡らずして、上へ上れ。</color>"
        },
        {
          "index": 4,
          "text": "口は災いの元だな…。",
          "speaker": "グレゴール"
        },
        {
          "index": 5,
          "text": "どうして、口が災いの元なの？",
          "speaker": "プイ"
        },
        {
          "index": 6,
          "text": "よっこらせっと…。\nときには…言わない方がいいこともあるんだよ。",
          "speaker": "グレゴール"
        }
      ]
    },
    {
      "key": "D5024",
      "texts": [
        {
          "index": 0,
          "text": "<…繭を守り抜かないと。>",
          "speaker": "ダンテ"
        }
      ]
    },
    {
      "key": "D5025",
      "texts": [
        {
          "index": 0,
          "text": "…異邦人。泉から現れ、階を自由に行き来する者たち。\nそして、上を目指し続ける者たち。",
          "speaker": "ル・ノワール ブランドマネージャー"
        },
        {
          "index": 1,
          "text": "あなた方の噂は、かねがね耳にしている。",
          "speaker": "ル・ノワール ブランドマネージャー"
        },
        {
          "index": 2,
          "text": "私に生地を作っていた当代のお直し職人を、\nあなた方が断ち切ったそうだな。",
          "speaker": "ル・ノワール ブランドマネージャー"
        },
        {
          "index": 3,
          "text": "この鎧を紡ぎ上げた先代のお直し職人は、ずっと昔、\n6階へとランウェイの旅に出た。ゆえに…しばらくは、\n地下の生地で服を縫い合わせるしかなさそうだ。",
          "speaker": "ル・ノワール ブランドマネージャー"
        },
        {
          "index": 4,
          "text": "<……。>",
          "speaker": "ダンテ"
        }
      ]
    },
    {
      "key": "D5025B",
      "texts": [
        {
          "index": 0,
          "text": "今、あなた方が守ろうとしている化け物は…\nいつか、この百貨店を枯渇させるだろう。",
          "speaker": "ル・ノワール ブランドマネージャー"
        },
        {
          "index": 1,
          "text": "既に予言された…運命にも等しいことだ。",
          "speaker": "ル・ノワール ブランドマネージャー"
        }
      ]
    },
    {
      "key": "D5025C",
      "texts": [
        {
          "index": 0,
          "text": "それは本質的に、偽りの存在…\n今からでも道を空けるなら、あなた方を責めはしない。",
          "speaker": "ル・ノワール ブランドマネージャー"
        }
      ]
    },
    {
      "key": "D5025D",
      "texts": [
        {
          "index": 0,
          "text": "…私にとり、プイ君は問い多く\n本性と意志との間にて思い悩む…嬰児に過ぎず。",
          "speaker": "イサン"
        },
        {
          "index": 1,
          "text": "そして…約束せしにあらずや。\n目覚むる時、傍にあらんと。",
          "speaker": "イサン"
        },
        {
          "index": 2,
          "text": "はぁ…そうだったな。だから、\n軽々しく約束なんかしちゃいけないんだよなぁ…。",
          "speaker": "グレゴール"
        }
      ]
    },
    {
      "key": "D5025E",
      "texts": [
        {
          "index": 0,
          "text": "愚かにも、邪なる者に魅入られたか。",
          "speaker": "ル・ノワール ブランドマネージャー"
        }
      ]
    },
    {
      "key": "D5025F",
      "texts": [
        {
          "index": 0,
          "text": "<……。>",
          "speaker": "ダンテ"
        },
        {
          "index": 1,
          "text": "<あの人の言うことが本当なら、シーシュポス百貨店は枯渇\nするだろうし…そうなれば、百貨店は前の選択と\n変わらない結末を迎えてしまいそうだ…。>",
          "speaker": "ダンテ"
        },
        {
          "index": 2,
          "text": "<そうなれば…私たちがやってきたことは全部、\n何の意味も残せないだろうね。>",
          "speaker": "ダンテ"
        },
        {
          "index": 3,
          "text": "<…言葉で説明するのは難しいけど…それでも、\n私はプイを守りたい。>",
          "speaker": "ダンテ"
        }
      ]
    },
    {
      "key": "D5025G",
      "texts": [
        {
          "index": 0,
          "text": "<今の私は…私の中から湧き上がる心は、\nそれを望んでいるから。>",
          "speaker": "ダンテ"
        }
      ]
    },
    {
      "key": "D5025H",
      "texts": [
        {
          "index": 0,
          "text": "目も眩むほど燦爛たる後光を背負い、\nあの者が金鎚を高々と振り上げる。"
        }
      ]
    },
    {
      "key": "D5025I",
      "texts": [
        {
          "index": 0,
          "text": "その瞬間、ふと湧いた疑問にムルソーの名を呼んだ。"
        }
      ]
    },
    {
      "key": "D5025J",
      "texts": [
        {
          "index": 0,
          "text": "<ムルソー。>",
          "speaker": "ダンテ"
        }
      ]
    },
    {
      "key": "D5025K",
      "texts": [
        {
          "index": 0,
          "text": "はい、管理人様。",
          "speaker": "ムルソー"
        }
      ]
    },
    {
      "key": "D5025L",
      "texts": [
        {
          "index": 0,
          "text": "<今回の選択を、私は…私たちは、後悔するのかな？>",
          "speaker": "ダンテ"
        }
      ]
    },
    {
      "key": "D5025M",
      "texts": [
        {
          "index": 0,
          "text": "……。",
          "speaker": "ムルソー"
        }
      ]
    },
    {
      "key": "D5025N",
      "texts": [
        {
          "index": 0,
          "text": "はい。恐らく、高い確率でそうなるでしょう。",
          "speaker": "ムルソー"
        }
      ]
    },
    {
      "key": "D5025O",
      "texts": [
        {
          "index": 0,
          "text": "ですが…大切なのは…。",
          "speaker": "ムルソー"
        }
      ]
    },
    {
      "key": "D5025P",
      "texts": [
        {
          "index": 0,
          "text": "轟音と共にムルソーの声は、かき消される。"
        }
      ]
    },
    {
      "key": "D5026",
      "texts": [
        {
          "index": 0,
          "text": "それで…トイレで大体は聞いたんだけど、\nこのプ…とかいうやつを、ここまで連れてくる\n保護者役をしてた…ってことで、いいんだよな？",
          "speaker": "グレゴール"
        },
        {
          "index": 1,
          "text": "<そうだよ。>",
          "speaker": "ダンテ"
        },
        {
          "index": 2,
          "text": "道に迷いし嬰児を案内せしとは…良きことを為しけり。\nもとより、百貨店とはすこぶる道に迷いやすき所なれば…。",
          "speaker": "イサン"
        },
        {
          "index": 3,
          "text": "それにしても…ずいぶん長い廊下だな…\nしばらく歩くことになりそうだ。",
          "speaker": "グレゴール"
        }
      ]
    },
    {
      "key": "D5903",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "透明なガラス越しに、泳ぐ魚が見える。\n大勢の人がその中を歩き回り、あちこちを見物している。"
        }
      ]
    },
    {
      "key": "D5904",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[釘、そして金鎚]"
        }
      ]
    },
    {
      "key": "D5905",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[金鎚を受け止める釘]"
        }
      ]
    },
    {
      "key": "D5906",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[祝祭]"
        }
      ]
    },
    {
      "key": "D5907",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[忘却と飢え]"
        }
      ]
    },
    {
      "key": "D5908",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[煙と戦争]"
        }
      ]
    },
    {
      "key": "D5909",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[矛盾した豊かさ]"
        }
      ]
    },
    {
      "key": "D5910",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[野蛮の時代]"
        }
      ]
    },
    {
      "key": "D5911",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[心に留めるべき無念]"
        }
      ]
    },
    {
      "key": "D5912",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[木、蛇、そして果実]"
        }
      ]
    },
    {
      "key": "D5913",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[巨人たち]"
        }
      ]
    },
    {
      "key": "D5914",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[塔]"
        }
      ]
    },
    {
      "key": "D5915",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[絞首台]"
        }
      ]
    },
    {
      "key": "D5916",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[黒く赤いもの、赤く黒いもの。]"
        }
      ]
    },
    {
      "key": "D5917",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[啓蒙の時代]"
        }
      ]
    },
    {
      "key": "D5918",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[墜落する巨人]"
        },
        {
          "index": 2,
          "text": "…。",
          "speaker": "ムルソー"
        }
      ]
    },
    {
      "key": "D5919",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[大亀裂]"
        }
      ]
    },
    {
      "key": "D5920",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[断絶の時代]"
        }
      ]
    },
    {
      "key": "D5921",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[黄金の枝]"
        },
        {
          "index": 2,
          "text": "<…百貨店の過去みたいだけど。>",
          "speaker": "ダンテ"
        }
      ]
    },
    {
      "key": "D5922",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "何も見えない。"
        }
      ]
    },
    {
      "key": "D5925",
      "texts": [
        {
          "index": 0,
          "text": "何も見えない。"
        }
      ]
    },
    {
      "key": "D5926",
      "texts": [
        {
          "index": 0,
          "text": "何も見えない。"
        }
      ]
    },
    {
      "key": "D5927",
      "texts": [
        {
          "index": 0,
          "text": "何かがぼんやりと見える。"
        },
        {
          "index": 1,
          "text": "[崩す者たち]"
        }
      ]
    },
    {
      "key": "D5928",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[浮かび上がったものは、必然的に沈むものだ。]"
        }
      ]
    },
    {
      "key": "D5929",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[華やかな百貨店の最も底。吐き気を催す、堆積したものたち。]"
        }
      ]
    },
    {
      "key": "D5930",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[解けた糸をたどり出口へ向かったが、糸の端は切れてしまった。]"
        }
      ]
    },
    {
      "key": "D5931",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[上れず、投げ捨てることもできぬまま\n糸玉ばかり巻いては、また巻く。]"
        }
      ]
    },
    {
      "key": "D5932",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[膨れた腹を抱え、飢えた精神を叩く。]"
        }
      ]
    },
    {
      "key": "D5933",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[既に辿り着いたが、二度と辿り着けない味。]"
        }
      ]
    },
    {
      "key": "D5934",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[掠めて通り過ぎる全てのものは、容易く砕け散る。]"
        }
      ]
    },
    {
      "key": "D5935",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[色褪せた片隅で、戻ってくる刹那だけを待つ。]"
        }
      ]
    },
    {
      "key": "D5936",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[締めつけられた分だけ、権威はついてくるものだ。]"
        }
      ]
    },
    {
      "key": "D5937",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[視線に巻きつかれ、解けなくなるほど、\nついてくるものが多くなる。]"
        }
      ]
    },
    {
      "key": "D5938",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[誰にも、信念は必要だ。]"
        }
      ]
    },
    {
      "key": "D5939",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[畏敬の念は大抵、死んでいながら生きているものから生じる。]"
        }
      ]
    },
    {
      "key": "D5940",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[膝を突いた者たちを、何者も嘲笑うことはできない。]"
        }
      ]
    },
    {
      "key": "D5941",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[少なくとも、座り込むという選択は自らの手で下した。]"
        }
      ]
    },
    {
      "key": "D5942",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[たとえ飢えた腹を抱えようとも、精神は飢えない。]"
        }
      ]
    },
    {
      "key": "D5943",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[飢えは満たされるものではなく、満たすものだ。]"
        }
      ]
    },
    {
      "key": "D5944",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[一歩ごとに、自らを釘付けにする。]"
        }
      ]
    },
    {
      "key": "D5945",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[巡礼の道の果てには、皆が釘付けにした者だけが残っている。]"
        }
      ]
    },
    {
      "key": "D5946",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[何のために上るのか。]"
        }
      ]
    },
    {
      "key": "D5947",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[結局は下りるほかないのに。]"
        }
      ]
    },
    {
      "key": "D5923",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        }
      ]
    },
    {
      "key": "D5924",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "長い間見つめていると、模様が揺らめき始める。"
        },
        {
          "index": 2,
          "text": "<…これは。>",
          "speaker": "ダンテ"
        },
        {
          "index": 3,
          "text": "見えるはずのないものが、姿を現し始める。"
        }
      ]
    },
    {
      "key": "D5948",
      "texts": [
        {
          "index": 0,
          "text": "神の言葉を代弁していた助祭は、今やその座を降りた。"
        }
      ]
    },
    {
      "key": "DDS501",
      "texts": [
        {
          "index": 0,
          "text": "…プイが一人で残っています。",
          "speaker": "ムルソー"
        },
        {
          "index": 1,
          "text": "できるだけ早くレストランへ戻らねばなりません、管理人様。",
          "speaker": "ムルソー"
        }
      ]
    },
    {
      "key": "DDS502",
      "texts": [
        {
          "index": 0,
          "text": "<私たちを追ってきたんだ。\n正確には…プイを追ってきたみたい。>",
          "speaker": "ダンテ"
        },
        {
          "index": 1,
          "text": "黄金の繭、うにょりと呼ばれていた個体の\n親個体と推定されます。",
          "speaker": "ムルソー"
        },
        {
          "index": 2,
          "text": "<在庫整理の前にも…鳴き声を聞いて、やってきたよね。>",
          "speaker": "ダンテ"
        },
        {
          "index": 3,
          "text": "<……。>",
          "speaker": "ダンテ"
        },
        {
          "index": 4,
          "text": "<今は、どうやって倒すかだけ考えよう。>",
          "speaker": "ダンテ"
        },
        {
          "index": 5,
          "text": "<プイも待ってるから。>",
          "speaker": "ダンテ"
        },
        {
          "index": 6,
          "text": "うぅむ…薄暗くなれば、その姿は完全に消えたり。\nあたかも、存在せしことなどなきかのごとく…。",
          "speaker": "イサン"
        },
        {
          "index": 7,
          "text": "かと思えば、ぱっと現れたんだよな。でかいとはいえ、\n地面に触れてるのはあの尻尾みたいな部分だけだから\nろくに殴れるところもなかったし…。",
          "speaker": "グレゴール"
        },
        {
          "index": 8,
          "text": "暗闇は大きな障害ではない。\n落ち着いて動けば、難なく避けられる。",
          "speaker": "ムルソー"
        },
        {
          "index": 9,
          "text": "<…よし、今度はもう少し落ち着いて戦ってみよう。>",
          "speaker": "ダンテ"
        }
      ]
    },
    {
      "key": "D5949",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[流れに身を任せ、ただ漂う者たち。]"
        }
      ]
    },
    {
      "key": "D5950",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[黒い生地で自らを固定した者たち。]"
        }
      ]
    },
    {
      "key": "D5951",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "[内面をさらけ出し、外面を固定した者たち。]"
        }
      ]
    },
    {
      "key": "D5027",
      "texts": [
        {
          "index": 0,
          "text": "<color=#cf0000>百貨店の全ての者たちよ、聞け。</color>"
        },
        {
          "index": 1,
          "text": "<color=#cf0000>ついにビュッフェが完成した。\n汝らの誰一人として、二度と飢えることのないように…。</color>"
        },
        {
          "index": 2,
          "text": "<color=#cf0000>我々は、私は、百貨店の全てを食らい尽くそう。</color>"
        },
        {
          "index": 3,
          "text": "<color=#cf0000>もう待つな、もう叫ぶな、もはや…欲望するな。</color>"
        },
        {
          "index": 4,
          "text": "<color=#cf0000>食いちぎり、呑み込め。目に映るものを残らず。</color>"
        },
        {
          "index": 5,
          "text": "<color=#cf0000>皆5階へ上り、奴らが隠した珍味を腹いっぱい食らおう。</color>"
        },
        {
          "index": 6,
          "text": "<color=#cf0000>食べ物を持って参れ。</color>"
        },
        {
          "index": 7,
          "text": "<color=#cf0000>ル・ノワールも、ル・カーキも、ル・ルージュも…ビューティー\nフロアの化粧台、ラグジュアリーフロアの大理石、放送室のラッパと\n家具フロアの照明も。フードコートのブーシェと染色室の膿。浜辺に\n打ち寄せられた幼体と捨てられた皮も。そして、亀裂を埋めた黄金の皮までも。</color>"
        },
        {
          "index": 8,
          "text": "<color=#cf0000>その全てを私の前へ持って参れ。\nそして、その全てを食らおうではないか。</color>"
        }
      ]
    },
    {
      "key": "D5028",
      "texts": [
        {
          "index": 0,
          "text": "…もう先へ進まなくてもよいのか。",
          "speaker": "ムルソー"
        },
        {
          "index": 1,
          "text": "ここで全て満たせる。\nお腹が空いた分だけ食べて、喉が渇いた分だけ飲んで。",
          "speaker": "ビュッフェ"
        },
        {
          "index": 2,
          "text": "そうしていれば…どこかへ進みたいという気持ちが\n根を下ろす余地もなくなるはず。",
          "speaker": "ビュッフェ"
        }
      ]
    },
    {
      "key": "D5029",
      "texts": [
        {
          "index": 0,
          "text": "巨大なテーブルの上で辺りを見回したけど、\n私たちは結局、6階へ上る方法を見つけられなかった。"
        },
        {
          "index": 1,
          "text": "だから…私たちは隅に座って、\nビュッフェの食事を見守ることにした。"
        }
      ]
    },
    {
      "key": "D5030",
      "texts": [
        {
          "index": 0,
          "text": "サクッ。"
        },
        {
          "index": 1,
          "text": "ビュッフェが呑み込んだのは、皿の上のパン一切れだった。"
        },
        {
          "index": 2,
          "text": "次は、肉汁の滴るステーキで…。"
        },
        {
          "index": 3,
          "text": "その次には、端正に飾られた巨大なケーキが、\n跡形もなくビュッフェの口の中へ消えた。"
        },
        {
          "index": 4,
          "text": "それからは…ビュッフェが何を噛み、何を食べているのか、\nもう見分けられなくなった。"
        },
        {
          "index": 5,
          "text": "皿が。スプーンとナイフが、テーブルクロスが…\n区別なく、貪るようにビュッフェの口へ入っていく。"
        },
        {
          "index": 6,
          "text": "噛んでいるものを呑み込むよりも早く…\nビュッフェの手は、もう次のものを掴む。"
        },
        {
          "index": 7,
          "text": "味わうためにほんの一瞬待つことさえ、贅沢だと言わんばかりに。"
        }
      ]
    },
    {
      "key": "D5500",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "果てしなく広い広場と、その中央に立つ大きな建物が見える。\n大勢の人が、その間を行き交っている。"
        }
      ]
    },
    {
      "key": "D5501",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "息が詰まるほど暗い通路に、かすかな光が揺れている。\n辺りには缶詰が積まれ、洞窟のような狭い通路を\n人が行き交うのが見える。"
        }
      ]
    },
    {
      "key": "D5502",
      "texts": [
        {
          "index": 0,
          "text": "大きな窓から、光が降り注ぐように入ってくる。"
        },
        {
          "index": 1,
          "text": "人々が互いに向かって、絶えず叫んでいる。\n何を叫んでいるのかは分からないけれど…その様子は、\nまるで裁判のようだ。"
        }
      ]
    }
  ]
}
