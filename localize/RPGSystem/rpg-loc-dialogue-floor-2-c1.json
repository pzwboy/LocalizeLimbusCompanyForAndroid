{
  "dataList": [
    {
      "key": "D2001_C1",
      "texts": [
        {
          "index": 0,
          "text": "…全て話してしまったから、今は陽射しを避けるすべがない。",
          "speaker": "???"
        },
        {
          "index": 1,
          "text": "だから…この運命は、もっと過去へ戻らなければ\nならないだろうね。君たちにさえ、認知できないように。",
          "speaker": "???"
        }
      ]
    },
    {
      "key": "D2050",
      "texts": [
        {
          "index": 0,
          "text": "君たちが本当に運命を打ち砕いたとき、また返してあげるから…。",
          "speaker": "???"
        },
        {
          "index": 1,
          "text": "この朽ちゆく殿堂の前で…\n何をもって経験を繰り返すのか、選んで…。",
          "speaker": "???"
        }
      ]
    },
    {
      "key": "D2051",
      "texts": [
        {
          "index": 0,
          "text": "釘…。",
          "speaker": "???"
        },
        {
          "index": 1,
          "text": "割れたところを…再び打ち繋ぎ…。",
          "speaker": "???"
        },
        {
          "index": 2,
          "text": "揺らぐものを…元の場所に固定する…。",
          "speaker": "???"
        },
        {
          "index": 3,
          "text": "そう…崩れるものを…支え立たせる道へ…。",
          "speaker": "???"
        }
      ]
    },
    {
      "key": "D2052",
      "texts": [
        {
          "index": 0,
          "text": "金鎚…。",
          "speaker": "???"
        },
        {
          "index": 1,
          "text": "古びて崩れるものを…自らの手で壊し…。",
          "speaker": "???"
        },
        {
          "index": 2,
          "text": "その場所に、新たなものを…。",
          "speaker": "???"
        },
        {
          "index": 3,
          "text": "崩壊に抗わず…早めて…。",
          "speaker": "???"
        },
        {
          "index": 4,
          "text": "廃墟の上に…新たな声を…。",
          "speaker": "???"
        }
      ]
    },
    {
      "key": "D2053",
      "texts": [
        {
          "index": 0,
          "text": "また…送ってあげる…。",
          "speaker": "???"
        }
      ]
    },
    {
      "key": "D2054",
      "texts": [
        {
          "index": 0,
          "text": "また…送ってあげる…。",
          "speaker": "???"
        }
      ]
    }
  ]
}
