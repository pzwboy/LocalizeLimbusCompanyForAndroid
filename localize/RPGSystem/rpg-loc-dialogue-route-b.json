{
    "dataList": [
        {
            "key": "D999999",
            "texts": [
                {
                    "index": 0,
                    "text": "<……>",
                    "speaker": "但丁"
                },
                {
                    "index": 1,
                    "text": "<它突然出現殺掉了默尓索。為了防止逃砲，還堵住了路……>",
                    "speaker": "但丁"
                },
                {
                    "index": 2,
                    "text": "<為什么百貨店里会有那種東西游蕩……？>",
                    "speaker": "但丁"
                },
                {
                    "index": 3,
                    "text": "……這突然是在説什么？",
                    "speaker": "以實瑪利"
                },
                {
                    "index": 4,
                    "text": "<就是剛才遇到的，那个……>",
                    "speaker": "但丁"
                },
                {
                    "index": 5,
                    "text": "既不是紐曲也不是異想体。"
                },
                {
                    "index": 6,
                    "text": "但我也不確定能不能真的如此称呼它。"
                },
                {
                    "index": 7,
                    "text": "真是的，話説一半只会譲人更在意叭。",
                    "speaker": "格里高尓"
                },
                {
                    "index": 8,
                    "text": "<……人。>",
                    "speaker": "但丁"
                },
                {
                    "index": 9,
                    "text": "<我是指那个背上扎満了釘子的怪物。>",
                    "speaker": "但丁"
                },
                {
                    "index": 10,
                    "text": "那種存在……在抵達衛生間前，我未曾見過。",
                    "speaker": "李箱"
                },
                {
                    "index": 11,
                    "text": "<唔……？>",
                    "speaker": "但丁"
                },
                {
                    "index": 12,
                    "text": "……累了的話就再休息下叭，但丁。默尓也已經找到了……",
                    "speaker": "羅佳"
                },
                {
                    "index": 13,
                    "text": "<……>",
                    "speaker": "但丁"
                },
                {
                    "index": 14,
                    "text": "离開帯着担憂表情看向我的鐘表的罪人們，我立即向默尓索詢問了情况。"
                },
                {
                    "index": 15,
                    "text": "<默尓索。怎么了？難道袮也……>",
                    "speaker": "但丁"
                },
                {
                    "index": 16,
                    "text": "……我還記得，經理。",
                    "speaker": "默尓索"
                },
                {
                    "index": 17,
                    "text": "回答宁的問題，罪人們不記得是因為他們回帰了。",
                    "speaker": "默尓索"
                },
                {
                    "index": 18,
                    "text": "<回帰了……？>",
                    "speaker": "但丁"
                },
                {
                    "index": 19,
                    "text": "即百貨店被重置為經理作出某種選擇前的状態。",
                    "speaker": "默尓索"
                },
                {
                    "index": 20,
                    "text": "這是大多数存在无法察覚的現象，但我和經理似乎是例外。",
                    "speaker": "默尓索"
                },
                {
                    "index": 21,
                    "text": "<唔。那先暫且不談……究竟為什么会被重置捏……？>",
                    "speaker": "但丁"
                },
                {
                    "index": 22,
                    "text": "大概是希望經理宁作出其它選擇叭。",
                    "speaker": "默尓索"
                },
                {
                    "index": 23,
                    "text": "……因為之前的選擇，并没有被鎖鏈束縛。",
                    "speaker": "默尓索"
                },
                {
                    "index": 24,
                    "text": "<……>",
                    "speaker": "但丁"
                },
                {
                    "index": 25,
                    "text": "出去前，最好先整理一下思路。"
                },
                {
                    "index": 26,
                    "text": "究竟為何那人会出現……"
                },
                {
                    "index": 27,
                    "text": "為何，回帰了捏……"
                }
            ]
        },
        {
            "key": "D-9181",
            "texts": [
                {
                    "index": 0,
                    "text": "現在……不行……",
                    "speaker": "？？？"
                },
                {
                    "index": 1,
                    "text": "当命運……排列整斉時……",
                    "speaker": "？？？"
                }
            ]
        },
        {
            "key": "D-9182",
            "texts": [
                {
                    "index": 0,
                    "text": "和鞋子対上了視綫。"
                }
            ]
        },
        {
            "key": "D-9183",
            "texts": [
                {
                    "index": 0,
                    "text": "已經听不到飽含悲傷的哭声了。"
                }
            ]
        },
        {
            "key": "D-9184",
            "texts": [
                {
                    "index": 0,
                    "text": "已經撕裂得太歴害，没辦法縫補好了。"
                }
            ]
        },
        {
            "key": "D-9185",
            "texts": [
                {
                    "index": 0,
                    "text": "黑派的尸体。就連他們那引以為傲的面料也无法阻止這種結果。"
                }
            ]
        },
        {
            "key": "D-9186",
            "texts": [
                {
                    "index": 0,
                    "text": "黑派的尸体。血液浸透了衣服，将其逐漸変為暗紅色。"
                }
            ]
        },
        {
            "key": "DDS901",
            "texts": [
                {
                    "index": 0,
                    "text": "<幸好支咿也能一起進来。>",
                    "speaker": "但丁"
                },
                {
                    "index": 1,
                    "text": "<而且出乎意料地……很乖巧。>",
                    "speaker": "但丁"
                },
                {
                    "index": 2,
                    "text": "進入泉后，支咿似乎比在外面時更緊張。"
                },
                {
                    "index": 3,
                    "text": "大概……是因為人太多了叭。"
                }
            ]
        }
    ]
}