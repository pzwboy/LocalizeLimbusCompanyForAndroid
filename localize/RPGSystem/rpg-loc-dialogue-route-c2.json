{
  "dataList": [
    {
      "key": "DRSC01_C2",
      "texts": [
        {
          "index": 0,
          "text": "何度か死を経験した後、\n立ち去ろうとした私たちを、誰かが呼び止めた。"
        },
        {
          "index": 1,
          "text": "…もう少し楽な道があるよ。そっちに…行く…？",
          "speaker": "???"
        },
        {
          "index": 2,
          "text": "沈めば…安全だよ…。",
          "speaker": "???"
        }
      ]
    },
    {
      "key": "DRSC02_C2",
      "texts": [
        {
          "index": 0,
          "text": "これを巻いて…陽射しのもとへ…。",
          "speaker": "???"
        },
        {
          "index": 1,
          "text": "青い女は、ムルソーにマフラーを巻いてくれた。"
        }
      ]
    },
    {
      "key": "DRSC03_C2",
      "texts": [
        {
          "index": 0,
          "text": "苦痛は…変わらず…沈黙するよ…。",
          "speaker": "???"
        }
      ]
    },
    {
      "key": "DRSC10_C2",
      "texts": [
        {
          "index": 0,
          "text": "心が乱れていても…大丈夫…。",
          "speaker": "???"
        }
      ]
    },
    {
      "key": "DRSC12_C2",
      "texts": [
        {
          "index": 0,
          "text": "これを巻いて…陽射しのもとへ…。",
          "speaker": "???"
        },
        {
          "index": 1,
          "text": "青い女は、ムルソーにマフラーを巻いてくれた。"
        }
      ]
    },
    {
      "key": "DRSC13_C2",
      "texts": [
        {
          "index": 0,
          "text": "苦痛は…変わらず…沈黙するよ…。",
          "speaker": "???"
        }
      ]
    },
    {
      "key": "DRSC11_C2",
      "texts": [
        {
          "index": 0,
          "text": "これ以上沈めば…上れなくなるよ…。",
          "speaker": "???"
        }
      ]
    },
    {
      "key": "D4002_C2",
      "texts": [
        {
          "index": 0,
          "text": "…。"
        },
        {
          "index": 1,
          "text": "…。",
          "speaker": "ダンテ"
        },
        {
          "index": 2,
          "text": "…。",
          "speaker": "ムルソー"
        },
        {
          "index": 3,
          "text": "…。",
          "speaker": "ムルソー"
        }
      ]
    },
    {
      "key": "DINT01_C2",
      "texts": [
        {
          "index": 0,
          "text": "子どもたちは公園で、水切りをする経験缶詰を食べていた。\n私たちはその風景を、黙って眺めていたわ。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 1,
          "text": "誰かが見ていたら…平凡で、日常的なデートを楽しむ、\n仲のいい恋人たちだと思っただろうね。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 2,
          "text": "でも私はいつものように…少しも慣れなかった。\nこの上なく見知らぬ感覚に、恐怖とめまいを覚えていたわ。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 3,
          "text": "……。",
          "speaker": "ムルソー"
        },
        {
          "index": 4,
          "text": "その瞬間に…私はあなたの目に芽生える恐怖を感じた。\nあなたも、同じだったでしょうね。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 5,
          "text": "…生きてきて沢山の人と言葉を交わしたけど、\n実は、誰とも本当に会話したことはなかったと思うの。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 6,
          "text": "私は人々が見ているものからズレたところを見つめて、\n人々は、私の見ているものが見えない。私の感じるこのめまいを、\nどれほど説明しても理解してもらえない。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 7,
          "text": "…何ものでもない、その何かを説明するのに相応しい単語は\n私もまだ見つけられていない。",
          "speaker": "ムルソー"
        },
        {
          "index": 8,
          "text": "だから私たちも、多くは語り合わなかった。\nその必要がなかったから。",
          "speaker": "ムルソー"
        },
        {
          "index": 9,
          "text": "だから、よかった。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 10,
          "text": "あなたの前では…そのすべてを、\n説明しようとしなくてもよかったから。\n理由をつけようと、努めなくてもよかったから。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 11,
          "text": "そのすべての厄介さと、過酷さについて。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 12,
          "text": "…だから、自然と恋人になった。",
          "speaker": "ムルソー"
        },
        {
          "index": 13,
          "text": "定期的に会い、互いを受け容れて求めながら。",
          "speaker": "ムルソー"
        },
        {
          "index": 14,
          "text": "今この瞬間、私たちの話に耳を傾けている人たちの中に…。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 15,
          "text": "何人、私たちを理解してくれる人がいるんだろうね。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 16,
          "text": "誰もいない。誰も。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 17,
          "text": "世界に投げ出され、隙間なく釘を刺された人たちは…決して、\n私たちの世界を理解できないでしょうね。",
          "speaker": "ジャンヌ"
        }
      ]
    },
    {
      "key": "DINT02_C2",
      "texts": [
        {
          "index": 0,
          "text": "シネマ。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 1,
          "text": "シーシュポス…シネマ。あなたに似合う、居心地のいい\n素敵な場所ね。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 2,
          "text": "ここを見て、どう思う？",
          "speaker": "ジャンヌ"
        },
        {
          "index": 3,
          "text": "映画が始まると…席に座っていた多くの人々が、\n私に無関心になる。",
          "speaker": "ムルソー"
        },
        {
          "index": 4,
          "text": "その瞬間が、全ての人の視線を完全に捉えておくんだ。\nまるで…鎖のように。",
          "speaker": "ムルソー"
        },
        {
          "index": 5,
          "text": "…静かだ。だから、安らぐ。",
          "speaker": "ムルソー"
        }
      ]
    },
    {
      "key": "DINT02B_C2",
      "texts": [
        {
          "index": 0,
          "text": "止まったスクリーンの中で、缶詰の中の経験が終わる。"
        },
        {
          "index": 1,
          "text": "同じ経験缶詰をすくって食べた人々が、立ち上がる。"
        },
        {
          "index": 2,
          "text": "自分の見たものを楽しそうに話す人。感動を抑えきれず、まだ席に\n座っている人。不満な点があったのか、ぶつぶつと文句を言う人。"
        },
        {
          "index": 3,
          "text": "彼らは本当に同じ缶詰をすくって食べたのだろうか。\n本当に、私たちと同じ経験をしたのだろうか。"
        },
        {
          "index": 4,
          "text": "その数多くの悩みが終わりを迎えたとき、映画館には\n私とジャンヌしか残っていなかった。"
        }
      ]
    },
    {
      "key": "DINT02C_C2",
      "texts": [
        {
          "index": 0,
          "text": "分かってる。この都市も、あなたも、\nこの問いに答えてはくれないでしょうね。永遠に。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 1,
          "text": "……。",
          "speaker": "ムルソー"
        },
        {
          "index": 2,
          "text": "美しい夕焼けだった。\n目いっぱいに映るほど赤く、華やかだった。",
          "speaker": "ムルソー"
        },
        {
          "index": 3,
          "text": "涼しい風も、ざらつく砂の感覚も、すべて感じられた。",
          "speaker": "ムルソー"
        },
        {
          "index": 4,
          "text": "でも…結局、偽物にすぎないわ。私たちはただ、\nここに座っていただけだから。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 5,
          "text": "それなのに…人々は、この偽物がたまらなく好きなの。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 6,
          "text": "風ではないものを、風と呼び…夕焼けではないものを、\nためらいなく、夕焼けと呼ぶ。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 7,
          "text": "…そのすべてに恐怖を感じるのが、この広い映画館で\n私とあなただけなんて。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 8,
          "text": "不条理ね。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 9,
          "text": "…そうかもしれない。",
          "speaker": "ムルソー"
        }
      ]
    },
    {
      "key": "DINT04_C2",
      "texts": [
        {
          "index": 0,
          "text": "その日、映画館は休みだった。"
        },
        {
          "index": 1,
          "text": "予期せぬ変数に、私たちが計画もなく向かったのは…\n都心から少し離れた場所にあった、小さな人工の泉。"
        },
        {
          "index": 2,
          "text": "真昼の陽射しを避けるため、私たちはしばらく\nそこに座り…。"
        },
        {
          "index": 3,
          "text": "時が経ち、私たちは…。"
        },
        {
          "index": 4,
          "text": "沈みゆく夕焼けを、黙って見つめた。"
        },
        {
          "index": 5,
          "text": "消えゆくその赤い跡は、もう眩しくなかったから…。"
        },
        {
          "index": 6,
          "text": "私たちの汗は乾き、息は整った。"
        },
        {
          "index": 7,
          "text": "……。",
          "speaker": "ムルソー"
        },
        {
          "index": 8,
          "text": "……。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 9,
          "text": "その瞬間が生み出した沈黙の中で、私たちは…。"
        },
        {
          "index": 10,
          "text": "確かに、存在していた。"
        }
      ]
    },
    {
      "key": "DINT05_C2",
      "texts": [
        {
          "index": 0,
          "text": "缶詰の中の記憶ではなく、偶然見たあの夕焼け…。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 1,
          "text": "焼けながら沈んでいく、その姿が…。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 2,
          "text": "言葉にできないほど…美しくて…。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 3,
          "text": "私にも燃え移ってほしいと思った。",
          "speaker": "ジャンヌ"
        },
        {
          "index": 4,
          "text": "そうか、それなら…。",
          "speaker": "ムルソー"
        },
        {
          "index": 5,
          "text": "君はそうやって…進めばいい。",
          "speaker": "ムルソー"
        }
      ]
    },
    {
      "key": "D4000_C2",
      "texts": [
        {
          "index": 0,
          "text": "…そういえば、我らを追ってきたあの者から\n光っていたものが、すっかり消えたではないか？\n今なら…倒せるかもしれぬぞ！",
          "speaker": "ドンキホーテ"
        },
        {
          "index": 1,
          "text": "そうですけど…そのまま通り過ぎるのも手でしょうね。",
          "speaker": "ホンル"
        },
        {
          "index": 2,
          "text": "<……。>",
          "speaker": "ダンテ"
        }
      ]
    },
    {
      "key": "D9500",
      "texts": [
        {
          "index": 0,
          "text": "囚人たちが、私の判断を待っている。"
        }
      ]
    },
    {
      "key": "D9501",
      "texts": [
        {
          "index": 0,
          "text": "二度の終わりを全て思い出せば…\n三度目は恐ろしきよりも、気になりゆくなり。",
          "speaker": "イサン"
        },
        {
          "index": 1,
          "text": "これまで、苦労多かりき、ダンテ。\n今や共に立ち向かえん。",
          "speaker": "イサン"
        },
        {
          "index": 2,
          "text": "イサンに、大変だったことを軽く打ち明けた。"
        }
      ]
    },
    {
      "key": "D9502",
      "texts": [
        {
          "index": 0,
          "text": "ファウストの判断は…結果的に間違っていませんでしたね。",
          "speaker": "ファウスト"
        },
        {
          "index": 1,
          "text": "私とは違って…ですね。",
          "speaker": "ファウスト"
        },
        {
          "index": 2,
          "text": "今は…そっとしておいた方がよさそうだ。"
        }
      ]
    },
    {
      "key": "D9503",
      "texts": [
        {
          "index": 0,
          "text": "危うく、この素晴らしい冒険譚を\nすっかり忘れてしまうところだったとは…\n恐ろしいことこの上ないな…。",
          "speaker": "ドンキホーテ"
        },
        {
          "index": 1,
          "text": "準備が済んだら、また進もうではないか。\n管理人殿なら、必ず一番高いところへ辿り着けるはずゆえ！",
          "speaker": "ドンキホーテ"
        },
        {
          "index": 2,
          "text": "ドンキホーテは力強く決意を固めた。"
        }
      ]
    },
    {
      "key": "D9504",
      "texts": [
        {
          "index": 0,
          "text": "ふぅ…。",
          "speaker": "良秀"
        },
        {
          "index": 1,
          "text": "…切れたものが、また繋がったか。\nまぁ、思ったより見応えのある絵だった。",
          "speaker": "良秀"
        },
        {
          "index": 2,
          "text": "アラヤが同意するように、ぶんぶんと唸る。"
        }
      ]
    },
    {
      "key": "D9505",
      "texts": [
        {
          "index": 0,
          "text": "本心を隠して、見せまいとするのは昔の僕と同じですが…\nムルソーさんは、どこか違う気がします。",
          "speaker": "ホンル"
        },
        {
          "index": 1,
          "text": "意味がなくても止まらずにいるには、\n一体どんな心持ちでいれば…。",
          "speaker": "ホンル"
        },
        {
          "index": 2,
          "text": "ホンルと、ムルソーについて話を交わした。"
        }
      ]
    },
    {
      "key": "D9506",
      "texts": [
        {
          "index": 0,
          "text": "なあ、大丈夫か？\n列車に乗ったときも、今日ほどは巻き戻さなかった気がするぞ。",
          "speaker": "ヒースクリフ"
        },
        {
          "index": 1,
          "text": "最初は痛いって泣き喚いて、大騒ぎしてたのに…\nどうして「ほどほど」ってのがねぇんだよ、ほどほどが。",
          "speaker": "ヒースクリフ"
        },
        {
          "index": 2,
          "text": "ヒースクリフは、しばらく私の時計頭を叩いた。"
        }
      ]
    },
    {
      "key": "D9507",
      "texts": [
        {
          "index": 0,
          "text": "…話してくれなかった理由は分かりますけど、\n何だか気に入りませんね。",
          "speaker": "イシュメール"
        },
        {
          "index": 1,
          "text": "いや、私があれこれ質問したのは事実ですけど…\nあんなに面倒くさそうに…。",
          "speaker": "イシュメール"
        },
        {
          "index": 2,
          "text": "イシュメールに小言を言われた。"
        }
      ]
    },
    {
      "key": "D9508",
      "texts": [
        {
          "index": 0,
          "text": "思い出すと、ちょっと悔しいけど…ふふっ。\nそれでも私、結構うまくやってたね？",
          "speaker": "ロージャ"
        },
        {
          "index": 1,
          "text": "活躍する機会が一度きりだったのは残念だけど、\nそれでも私、ちょっとすごかったな～って感じなんだよね。",
          "speaker": "ロージャ"
        },
        {
          "index": 2,
          "text": "誇らしげなロージャを褒めた。"
        }
      ]
    },
    {
      "key": "D9509",
      "texts": [
        {
          "index": 0,
          "text": "結局、あの方は…何だったんでしょう？\n僕たちを助けてくれたのは確かですけど…。",
          "speaker": "シンクレア"
        },
        {
          "index": 1,
          "text": "デミアンに会ったときよりも、\n更によく分からない気分です。",
          "speaker": "シンクレア"
        },
        {
          "index": 2,
          "text": "シンクレアは今も、泉の女について\n気になることが多いようだ。"
        }
      ]
    },
    {
      "key": "D9510",
      "texts": [
        {
          "index": 0,
          "text": "大変な作戦だったでしょうに、\n見事に完遂なさいましたね。",
          "speaker": "ウーティス"
        },
        {
          "index": 1,
          "text": "さすがは管理人様です。",
          "speaker": "ウーティス"
        },
        {
          "index": 2,
          "text": "初めて会った頃に比べると、\nウーティスの面映ゆい褒め言葉も\nそれほど負担に感じなくなった気がする。"
        }
      ]
    },
    {
      "key": "D9511",
      "texts": [
        {
          "index": 0,
          "text": "体がだるくて…疲れるな。",
          "speaker": "グレゴール"
        },
        {
          "index": 1,
          "text": "帰ったら、少し休もうぜ。\n管理人の旦那も、相当苦労したじゃないか。",
          "speaker": "グレゴール"
        },
        {
          "index": 2,
          "text": "グレゴールと一緒に、会社の愚痴をこぼした。"
        }
      ]
    },
    {
      "key": "D9512",
      "texts": [
        {
          "index": 0,
          "text": "……。",
          "speaker": "ムルソー"
        },
        {
          "index": 1,
          "text": "これで、上へ進めそうですね。",
          "speaker": "ムルソー"
        },
        {
          "index": 2,
          "text": "ムルソーは、変わらず淡々としている。"
        }
      ]
    },
    {
      "key": "D9513",
      "texts": [
        {
          "index": 0,
          "text": "泉の扉。この向こうに何があるのか、\n永遠に分からない気がする。"
        }
      ]
    },
