                    "text": "!+% %@@ *#&%? @% !%% ^+! @!& &#* %#+ +#* #^*& ?#+&@?"
                },
                {
                    "index": 6,
                    "text": "*@ ?&# #&+& $ *&*% ?& ?%# ?!@!"
                }
