    {
      "key": "D1901_C1",
      "texts": [
        {
          "index": 0,
          "text": "あなたたちが望む道を見つけるには、\n看守を倒さなければならない。",
          "speaker": "???"
        }
      ]
    },
    {
      "key": "D1014_C1",
      "texts": [
        {
          "index": 0,
          "text": "…(黙って、私を見ている。顔に浮かぶ穏やかな笑みから、\n私たちを好意的に思っていると分かる)",
          "speaker": "???"
        }
      ]
    },
    {
      "key": "D10141_C1",
      "texts": [
        {
          "index": 0,
          "text": "…トイレだよ。",
          "speaker": "???"
        },
        {
          "index": 1,
          "text": "<なるほど…。>",
          "speaker": "ダンテ"
        },
        {
          "index": 2,
          "text": "<じゃなくて、私の時計の音が分かるの！？>",
          "speaker": "ダンテ"
        },
        {
          "index": 3,
          "text": "…(言葉はないけれど、微笑みは変わらず浮かべている)",
          "speaker": "???"
        }
      ]
    },
    {
      "key": "D10142_C1",
      "texts": [
        {
          "index": 0,
          "text": "…星を追っていけば、いつか…。",
          "speaker": "???"
        },
        {
          "index": 1,
          "text": "…星を…。",
          "speaker": "シンクレア"
        },
        {
          "index": 2,
          "text": "シンクレアは深く考え込んでいるようだ。"
        }
      ]
    },
    {
      "key": "D10143_C1",
      "texts": [
        {
          "index": 0,
          "text": "…(答えない。正体を探ろうとしても無駄そうだ)",
