        },
        {
            "key": "NAR_3F_HighDomestic_3",
            "texts": [
                {
                    "index": 0,
                    "text": "<color=#cf0000>期望叭。如這分期望般，絶不罷休地消耗叭。</color>"
                }
            ]
        },
        {
